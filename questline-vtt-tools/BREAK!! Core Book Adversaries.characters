        "temp": 0,
        "tempMax": 0
      },
      "abilities": [
        {
          "description": "*Giga Gruun are devoid of discipline or grace, they fight with relentless brutality.*\n\nIn addition to its other permitted Actions, the Giga Gruun can make a bonus Combat Action.",
          "id": "3EgECFsujoeCp2ZyhIKK",
          "modifiers": [],
          "linkedValue": null,
          "name": "Furious Rampage ",
          "value": 0,
          "subtext": "",
          "counters": {},
          "counterOverrides": {},
          "originId": "furious-rampage"
        },
        {
          "counters": {},
          "subtext": "",
          "value": 0,
          "name": "Giga Body [B]",
          "originId": "giga-body-b",
          "counterOverrides": {},
          "linkedValue": null,
          "modifiers": [],
          "id": "wGDux9vJhDCBMoYf3r4z",
          "description": "*The Giga Gruun are 15 feet tall, and mostly bone and muscle.*\n\n- Giga Gruun are Massive.\n- **Sweep Attack:** Flailing arms or Tusks strike as Arc Weapons.\n- **Focus Attack:** Stomps and headbutts strike as Mighty Weapons."
        },
        {
          "description": "*These biological war machines were manufactured to withstand severe punishment, both physical and magical.*\n\n- +6 Defense Rating.\n- Giga Gruun gain an Edge on Checks or Contests that involve resisting the effects of Magic Abilities.\n- Spell disrupting patterns woven into the Giga Gruuns skin reduce the Damage caused by offensive Magic Abilities by 1 Heart.",
          "id": "e2ldDcZ4PIZQJ7yRvIsJ",
          "modifiers": [],
          "linkedValue": null,
          "counterOverrides": {},
          "originId": "giga-hide-l",
          "name": "Giga Hide [L]",
          "value": 0,
          "subtext": "",
          "counters": {}
        }
      ],
      "notes": [
        {
          "counters": {},
          "subtext": null,
          "type": "Quick Facts",
          "counterOverrides": {},
          "originId": "communication",
          "valueSuffix": null,
          "starValue": null,
          "description": "Giga Gruun only\nunderstand Low Speech and will\nget angry when spoken to in\nanother tongue.",
          "value": 0,
          "name": "Communication",
          "bonus": 0,
          "valuePrefix": null,
          "id": "JDm96QLri1PZxDEtbYaH",
          "linkedValue": null,
          "modifiers": []
        },
        {
          "subtext": null,
          "counters": {},
          "type": "Quick Facts",
          "counterOverrides": {},
          "originId": "customization",
          "valueSuffix": null,
          "starValue": null,
          "description": "Some Giga Gruun\ncarry massive weapons that do +1\nHeart of Damage compared to their\nman-sized equivalents.",
          "name": "Customization",
          "value": 0,
          "bonus": 0,
          "valuePrefix": null,
          "id": "1ig1Yy21lL5QxhbJORbn",
          "modifiers": [],
          "linkedValue": null
        },
        {
          "bonus": 0,
          "valuePrefix": null,
          "id": "tNv1b08GFmny3KMe1OQU",
          "modifiers": [],
          "linkedValue": null,
          "name": "Habitat",
          "value": 0,
          "valueSuffix": null,
          "starValue": null,
          "description": "Giga Gruun distrust the dark\nso they remain outdoors in the\nsunny hemisphere.",
          "subtext": null,
          "counters": {},
          "type": "Quick Facts",
          "counterOverrides": {},
          "originId": "habitat"
        },
        {
          "value": 0,
          "name": "Indicators",
          "linkedValue": null,
          "modifiers": [],
          "id": "Z72d3ozmb7zEUKWcYTVM",
          "valuePrefix": null,
          "bonus": 0,
          "originId": "indicators",
          "type": "Quick Facts",
          "counterOverrides": {},
          "counters": {},
          "subtext": null,
          "description": "Broken structures, angry\nbellowing, massive footprints.",
          "starValue": null,
          "valueSuffix": null
        },
        {
          "bonus": 0,
          "valuePrefix": null,
          "id": "D4EDbkUTGIcJtmcI1OVC",
          "modifiers": [],
          "linkedValue": null,
          "name": "Role Playing Notes",
          "value": 0,
          "valueSuffix": null,
          "starValue": null,
          "description": "Violent and\nemotionally stunted, Giga Gruun are\nlike malicious children. While not\nentirely unreasonable, they will get\naggressive if things get too\ncomplicated for them.",
          "subtext": null,
          "counters": {},
          "type": "Quick Facts",
          "counterOverrides": {},
          "originId": "role-playing-notes"
        },
        {
          "value": 0,
          "name": "Tactics",
          "id": "h3mX4dBzq5tBOj2jTifO",
          "linkedValue": null,
          "modifiers": [],
          "bonus": 0,
          "valuePrefix": null,
          "type": "Quick Facts",
          "counterOverrides": {},
          "originId": "tactics",
          "counters": {},
          "subtext": null,
          "description": "Giga Gruun are not smart, but know they are strong, and will:\n- Take pleasure in crushing the strongest opponents first.\n- Grab and Restrain opponents in their enormous hands, or toss them out of the Battlefield.\n\nIn spite of all their anger, Giga Gruun are fond of tiny creatures and will:\n- Not harm Small PCs or creatures, unless they are attacking them.\n- Attempt to claim any surviving tiny folk as their pets.",
          "valueSuffix": null,
          "starValue": null
        }
      ]
    },
    "version": 9,
    "baseScale": 1,
    "name": "[9] Giga Gruun"
  },
