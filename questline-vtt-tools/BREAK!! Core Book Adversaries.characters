          "id": "9O7qEoB39foURtJvURGF",
          "valuePrefix": null,
          "bonus": 0,
          "originId": "habitat",
          "counterOverrides": {},
          "type": "Quick Facts",
          "counters": {},
          "subtext": null,
          "description": "These strays have spread\nfrom the Pride Coast, their ancestral\nhomeland, in search of coin.",
          "starValue": null,
          "valueSuffix": null
        },
        {
          "subtext": null,
          "counters": {},
          "originId": "indicators",
          "type": "Quick Facts",
          "counterOverrides": {},
          "starValue": null,
          "valueSuffix": null,
          "description": "Gnawed sticks, the sound\nof growling and howling, corpses\nwith throwing knives in their backs.",
          "name": "Indicators",
          "value": 0,
          "valuePrefix": null,
          "bonus": 0,
          "modifiers": [],
          "linkedValue": null,
          "id": "PIFb8LEfKZQOs9FZFekV"
        },
        {
          "name": "Role Playing Notes",
          "value": 0,
          "id": "GzhIRhnUT9f7TZGnt4A8",
          "modifiers": [],
          "linkedValue": null,
          "bonus": 0,
          "valuePrefix": null,
          "type": "Quick Facts",
          "counterOverrides": {},
          "originId": "role-playing-notes",
          "subtext": null,
          "counters": {},
          "description": "Packs consist of\nvaried personalities. Universally\npragmatic and ruthless, most have a\nstrong sense of loyalty to the pack\nand feel they are in it together,\nsurviving in a cruel world.",
          "valueSuffix": null,
          "starValue": null
        },
        {
          "originId": "tactics",
          "type": "Quick Facts",
          "counterOverrides": {},
          "subtext": null,
          "counters": {},
          "description": "Mange are cowardly\ncombatants and will:\n- Use ambush techniques.\n- Use ranged attacks when they are\nlow in number.\n- Will only engage in melee if they are confident of the win.",
          "starValue": null,
          "valueSuffix": null,
          "name": "Tactics",
          "value": 0,
          "modifiers": [],
          "linkedValue": null,
          "id": "6K7yva9uprm4cXv5iEfm",
          "valuePrefix": null,
          "bonus": 0
        }
      ],
      "abilities": [
        {
          "linkedValue": null,
          "modifiers": [],
          "id": "xtCVs0chjv379gQjoR3o",
          "description": "*Mundymutts hear and smell better than any other species in the Outer World.*\n\n- Mange have an Edge on all Insight Checks and Contests involving hearing or sense of smell. For example, tracking or sniffing out a hidden or disguised individual.\n- Mange can smell mana and can tell when magic of any kind is being used, or was recently used, nearby. They can even discern between Bright and Dark mana.\n- Things not native to Outer World (Dimensional Strays, Asuras, Devas, etc.) smell off and make them uneasy. This could explain their infamous dislike of the Rai-Neko.",
          "counters": {},
          "subtext": "",
          "value": 0,
          "name": "Doggone Good Sense ",
          "originId": "doggone-good-sense",
          "counterOverrides": {}
        },
        {
          "description": "*Bandit pups learn fast that stragglers are left behind.*\n\nMange Bandits are Fast.",
          "id": "pNBftPf0KJyWu6e8DCH7",
          "modifiers": [],
          "linkedValue": null,
          "name": "Strays Step [B]",
          "value": 0,
          "subtext": "",
          "counters": {},
          "counterOverrides": {},
          "originId": "strays-step-b"
        }
      ],
