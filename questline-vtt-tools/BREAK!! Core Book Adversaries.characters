      "abilities": [
        {
          "counterOverrides": {},
          "originId": "living-dead-b",
          "value": 0,
          "name": "Living Dead [B]",
          "counters": {},
          "subtext": "",
          "id": "Qc5SHGKxaDEtiSLXcXuW",
          "description": "*Skelefolk are not subject to the afflictions that plague the living.*\n\n- Immune to Fatigue, Starvation, Suffocation, and aging.\n- Immune to toxins that target living tissue which are ingested, inhaled, or injected, except\n- The eyes and tongue are still subject to attacks that target living tissues. Destroying them demotes them to a Skeleman.\n- Adds 1 Dark Allegiance Point.",
          "linkedValue": null,
          "modifiers": []
        },
        {
          "linkedValue": null,
          "modifiers": [],
          "id": "sKCyCuX5K6JmeO5CymtW",
          "description": "*You can’t keep an evil Skelemaster down.*\n\n- When reduced to 0 Hearts, or less, their bones clatter to the ground, but over the next 3 Turns they will reform, all Hearts restored.\n- The GM may decide a crushing or obliterating attack prevents Self-Assembly. Otherwise, youll need to take a Turn to shatter the skull to prevent reanimation.\n- Adds 1 Dark Allegiance Point.",
          "counters": {},
          "subtext": "",
          "value": 0,
          "name": "Pull Yourself Together ",
          "originId": "pull-yourself-together-skelemaster",
          "counterOverrides": {}
        },
        {
          "counters": {},
          "subtext": "",
          "value": 0,
          "name": "Hollow Eyed Servants [A][M]",
          "originId": "hollow-eyed-servants-a-m",
          "counterOverrides": {},
          "linkedValue": null,
          "modifiers": [],
          "id": "V4tcKSCD3kIh4uqIjArp",
          "description": "*Skelemen keep a hollow-eyed vigil for their masters.*\n\n- Skelemasters are instantly aware of anything a Skeleman or Clacking Cranium within 1 mile of them sees or hears.\n- The ability is limited to a 1 mile radius from the Skelemaster.\n- Adds 1 Dark Allegiance Point."
        }
      ],
