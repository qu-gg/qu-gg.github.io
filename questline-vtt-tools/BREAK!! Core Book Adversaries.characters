          "value": 0,
          "bonus": 0,
          "valuePrefix": null,
          "id": "lVhvXW3PExMkmU4qzgNq",
          "modifiers": [],
          "linkedValue": null,
          "subtext": null,
          "counters": {},
          "counterOverrides": {},
          "type": "Quick Facts",
          "originId": "habitat",
          "valueSuffix": null,
          "starValue": null,
          "description": "Found in the service of\nOuter World’s most wealthy, such as\nthe Patricians of Shard or the Samurai\nof the Seven Holy Isles."
        },
        {
          "modifiers": [],
          "linkedValue": null,
          "id": "4IiDtAhXo41blLxuFHbj",
          "valuePrefix": null,
          "bonus": 0,
          "name": "Indicators",
          "value": 0,
          "description": "Noticeably well ordered\nareas, the sound of patient footsteps,\na body of someone slain by clean,\nprecise cuts.",
          "starValue": null,
          "valueSuffix": null,
          "originId": "indicators",
          "counterOverrides": {},
          "type": "Quick Facts",
          "subtext": null,
          "counters": {}
        },
        {
          "starValue": null,
          "valueSuffix": null,
          "description": "Polite to a fault.\nThey put duty before emotion and\nare respectful no matter what\ntheir intent.",
          "counters": {},
          "subtext": null,
          "originId": "role-playing-notes",
          "counterOverrides": {},
          "type": "Quick Facts",
          "valuePrefix": null,
          "bonus": 0,
          "linkedValue": null,
          "modifiers": [],
          "id": "ypen3S8FezKIOfJILZb7",
          "value": 0,
          "name": "Role Playing Notes"
        },
        {
          "value": 0,
          "name": "Tactics",
          "id": "bFzty7kVs6XeT2wEjszY",
          "linkedValue": null,
          "modifiers": [],
          "bonus": 0,
          "valuePrefix": null,
          "type": "Quick Facts",
          "counterOverrides": {},
          "originId": "tactics",
          "counters": {},
          "subtext": null,
          "description": "Butlers work best when they\nare part of a team and will:\n- Attempt to thwart the most challenging opponent while their compatriots pick off the rest.\n- If isolated, they will withdraw unless\nthey are acting as a decoy.",
          "valueSuffix": null,
          "starValue": null
        }
      ],
      "abilities": [
        {
          "linkedValue": null,
          "modifiers": [],
          "id": "j5kkoyfsU3CskM9LRciX",
          "valuePrefix": null,
          "bonus": 0,
          "value": 0,
          "name": "Immaculate Uniform ",
          "description": "*True maids take pride in their appearance, yet understand their uniform must be fit for the job at hand.*\n\n- Murder Maids wear Light Armor combined with an Appealing Outfit.\n- +2 Defense Rating.",
          "starValue": null,
          "valueSuffix": null,
          "originId": "immaculate-uniform",
          "counterOverrides": {},
          "type": null,
          "counters": {},
          "subtext": ""
        },
        {
          "value": 0,
          "name": "Tidy Battle Stance [A]",
          "valuePrefix": null,
          "bonus": 0,
          "linkedValue": null,
          "modifiers": [],
          "id": "uBiaKZXeyladc28PzMlQ",
          "counters": {},
          "subtext": "",
          "originId": "tidy-battle-stance-a",
          "counterOverrides": {},
          "type": null,
          "starValue": null,
          "valueSuffix": null,
          "description": "*Battle Butlers are elegant combatants.*\n\n- Every Battle Butler has a Weapon Type they are proficient in. Using their Chosen Weapon provides:\n  - +1 Attack Bonus.\n  - +2 Defense Rating.\n  - A Battle Butlers Chosen Weapon has a Custom Ability (p160)."
        },
        {
          "counterOverrides": {},
          "originId": "expeditious-manner-b",
          "value": 0,
          "name": "Expeditious Manner [B]",
          "counters": {},
          "subtext": "",
          "id": "5N2EBLs9wfnJyd3uIBYJ",
          "description": "*The Battle Butlers move with alacrity.*\n\nBattle Bulters are Fast.",
          "linkedValue": null,
          "modifiers": []
        },
        {
          "name": "Unruffled Monotony [A]",
          "value": 0,
          "modifiers": [],
          "linkedValue": null,
          "id": "M3loaLm9zF6SpKvHpLyp",
          "valuePrefix": null,
          "bonus": 0,
          "originId": "unruffled-monotony-a",
          "type": null,
          "counterOverrides": {},
          "subtext": "",
          "counters": {},
          "description": "*A Battle Butler prefers to prevent a disaster rather than mop up afterwards.*\n\nA Battle Butler can use their Action in an attempt to thwart any weapon Attack made in the same Battlefield Area as them.\n- This Ability must be declared before an Attack roll is made.\n\n**Requires a Contest**\n- The Butlers Grit vs. the attackers Might.\n- **Success:** The attacker falters and cannot act on their Turn.\n  - Battle Butlers have a Minor Bonus (+2) on Checks and Contests connected to keeping things on track.",
          "starValue": null,
          "valueSuffix": null
        }
      ],
