      "abilities": [
        {
          "modifiers": [],
          "type": "Mount Ability",
          "id": "ksN970At5SIFMtwJRhnf",
          "description": "Their tough shell\nboosts their Defense Rating by +4.",
          "counters": {},
          "value": 0,
          "name": "Exoskeleton"
        },
        {
          "modifiers": [],
          "type": "Mount Ability",
          "id": "OZ75m9NlmuUfP69bKwx1",
          "description": "The Jumbug is capable of\nSupernatural Leaping. Any\njumps attempted during a Fight, or\nsimilarly tense situation, require the\nrider to make a Deftness or Might\nCheck to avoid falling off and being\nToppled.\n\n**Supernatural Leaping**:\n- During a Fight, you can leap up to\n2 Battlefield Areas away and still\ntake your Action.\n- Leaping allows you to reach\nelevated locations beyond normal\nreach. For example, jumping up\nto strike an airborne foe or to gain\naccess to a distant ledge. Your GM\nwill decide what’s possible.\n- If you can control your descent, you\navoid Falling Injury when\nlanding from great heights.",
          "counters": {},
          "value": 0,
          "name": "Boing"
        },
        {
          "counters": {},
          "name": "Grazing",
          "value": 0,
          "modifiers": [],
          "description": "They require an environment with sufficient relevant nutrition to Graze.",
          "type": "Mount Ability",
          "id": "dGjimE501mQS9RfqCJB6"
        }
      ]
