          "bonus": 0,
          "name": "Role Playing Notes",
          "value": 0,
          "description": "Pleasant and\npolite when on duty, but individuals\ncan be shy, bubbly or brusque.",
          "starValue": null,
          "valueSuffix": null,
          "originId": "role-playing-notes",
