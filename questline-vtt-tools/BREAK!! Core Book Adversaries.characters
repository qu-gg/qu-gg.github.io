        "abilities": [
          {
            "counters": {},
            "subtext": "The drone is a mechanical being.",
            "value": 0,
            "name": "Synthetic",
            "id": "fnYBzZWu0z8FTuETfrLx",
            "type": "Basic Ability",
            "order": 0,
            "description": "- Immune to Fatigue, Starvation, and Suffocation.\n- Immune to toxins that target living tissue which are ingested, inhaled, or injected.\n- Drones are powered by an engine that feeds on ambient mana. If the flow of mana into the engine is disrupted they will then cease to function."
          },
          {
            "order": 1,
            "description": "The Drone can enter at will into an erratic, rampaging state that:\n- Grants a Minor Bonus (+2) to Might rolls.\n- Provides +1 Heart of Damage to physical Attacks.\n- Causes a -2 to their Defense Rating, due to reckless flailing.\n\nAttempting to exit this state requires the Drone to make a successful Insight Check.",
            "id": "batI5gZA8Tz75CFTc79f",
            "type": "Basic Ability",
            "subtext": "As a result of overexposure to mana, the Drone now has thoughts and feelings it wasn’t designed to process.",
            "counters": {},
            "name": "Mad Machine",
            "value": 0
          },
          {
            "description": "It has:\n- +4 Defense Rating.\n- +1 Hearts Total.\n- Maintenance Drones are Slow.\n- Mechanical limbs strike as Standard Weapons.",
            "type": "Basic Ability",
            "id": "4xT5s7QjZcBPTJcjgRrF",
            "name": "Labor Frame ",
            "value": 0,
            "subtext": "The Maintenance Drone’s body is engineered for industrial work.",
            "counters": {}
          }
        ],
