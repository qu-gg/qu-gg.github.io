      "bio": {
        "type": "Folk [Animal-kin]",
        "background": "",
        "size": "Small",
        "name": "Mange Hexer",
        "details": "**Ruff neck miscreant.** Outcasts banished from their pack for heinous crimes.\nThe exile extends to their offspring, resulting in the formation of bandit packs.",
        "subname": "Rank 1 Boss",
        "profileImage": null,
        "appearance": "",
