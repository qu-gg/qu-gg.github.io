      "bio": {
        "name": "Tiny Unhelpful Cloud",
        "details": "**Nimbostratus Nemesis.** A strange cousin of the Very Useful Cloud,\nTiny Unhelpful Clouds are actually the manifestation of another creature’s\nunpleasantness. These minuscule menaces stick close to their progenitor, and\nwork hard to be a pain in the neck for just about anyone else.",
        "size": "Small",
        "type": "Monster [Manifestation]",
        "background": "",
        "tokenCrop": "",
        "appearance": "",
        "profileImage": null,
        "characteristics": {
          "weight": "",
          "age": "",
          "hair": "",
          "skin": "",
