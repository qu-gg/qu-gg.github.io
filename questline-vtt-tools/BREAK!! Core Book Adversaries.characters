        {
          "name": "Brute",
          "value": 0,
          "subtext": "",
          "counters": {},
          "description": "*The quickest path between two places is often right through whatever is in the way.*\n\n- You get an Edge on any Attack rolls dedicated to Sundering (p263) something.\n- Any non-magical shield used to Parry your physical Attacks is immediately Sundered, due to the crushing power of your blows.\n\nThis Ability can not be used in conjunction with an Attack Stunt (p255).",
          "id": "SXM4Mwb7NaiahsghOKPA",
          "modifiers": []
        }
