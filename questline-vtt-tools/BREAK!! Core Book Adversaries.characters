      "notes": [
        {
          "value": 0,
          "name": "Communication",
          "linkedValue": null,
          "modifiers": [],
          "id": "7tknFYjLpvaEHhUTago8",
          "valuePrefix": null,
          "bonus": 0,
          "originId": "communication",
          "type": "Quick Facts",
          "counterOverrides": {},
          "counters": {},
          "subtext": null,
          "description": "Undead Peddlers\nare well versed in every language\nused in the Outer World, they want\nto guarantee they can do business\nwith anyone they meet.",
          "starValue": null,
          "valueSuffix": null
        },
        {
          "linkedValue": null,
          "modifiers": [],
          "id": "fQYr7pbNE612tKOYpiBK",
          "valuePrefix": null,
          "bonus": 0,
          "value": 0,
          "name": "Customization",
          "description": "More fortunate\nUndead Peddlers travel with\nSkeleman bodyguards. It’s also\nrumored that some Peddlers possess\nmagical inventory boxes that can\nhold a vast amount of items.",
          "starValue": null,
          "valueSuffix": null,
          "originId": "customization",
          "counterOverrides": {},
          "type": "Quick Facts",
          "counters": {},
          "subtext": null
        },
        {
          "value": 0,
          "name": "Habitat",
          "id": "aX4YePmIXQUnSQ7KC8Df",
          "linkedValue": null,
          "modifiers": [],
          "bonus": 0,
          "valuePrefix": null,
          "counterOverrides": {},
          "type": "Quick Facts",
          "originId": "habitat",
          "counters": {},
          "subtext": null,
          "description": "Found almost exclusively in\nmonster filled dungeons, ruins and\ncave networks. Peddlers occasionally\nwander the roads of the Wistful Dark\nand Buried Kingdom.",
          "valueSuffix": null,
          "starValue": null
        },
        {
          "type": "Quick Facts",
          "counterOverrides": {},
          "originId": "indicators",
          "subtext": null,
          "counters": {},
          "description": "Clamor made by the\nrattling of merchandise, dungeon\ninhabitants with gear they wouldn’t\nnormally have, signs that say “Sale\nEnd is Nigh”.",
          "valueSuffix": null,
          "starValue": null,
          "name": "Indicators",
          "value": 0,
          "id": "Y8UxaZCLfZuLXxNjrKOO",
          "modifiers": [],
          "linkedValue": null,
          "bonus": 0,
          "valuePrefix": null
        },
        {
          "subtext": null,
          "counters": {},
          "originId": "role-playing-notes",
          "counterOverrides": {},
          "type": "Quick Facts",
          "starValue": null,
          "valueSuffix": null,
          "description": "Undead\nPeddlers are consummate dealmakers\nwith a certain charm to them.\nThey will do anything to pursue a sale\nas long as it means some sort of\nprofit, though they don’t take kindly\nto threats or other overly aggressive\ntechniques. Being so used to dealing\nwith any number of monsters and\nunsavory customers, it’s actually\npretty hard to phase them.",
          "name": "Role Playing Notes",
          "value": 0,
          "valuePrefix": null,
          "bonus": 0,
          "modifiers": [],
          "linkedValue": null,
          "id": "J6R3wufPtlj8IHns20ST"
        },
        {
          "valuePrefix": null,
          "bonus": 0,
          "modifiers": [],
          "linkedValue": null,
          "id": "SdP4hyFk39hZ0Ywb4IHU",
          "name": "Tactics",
          "value": 0,
          "starValue": null,
          "valueSuffix": null,
          "description": "Peddlers are not really into\nfighting. They will offer a free item if\nthreatened by someone tough, but\nhappily blow themselves up rather\nthan let greedy murder hobos make\noff with their goods.",
          "subtext": null,
          "counters": {},
          "originId": "tactics",
          "counterOverrides": {},
          "type": "Quick Facts"
        }
      ],
      "abilities": [
        {
          "value": 0,
          "name": "Corpse Commodities [B]",
          "linkedValue": null,
          "modifiers": [],
          "id": "VY3FohmIIpo89QbrLj46",
          "valuePrefix": null,
          "bonus": 0,
          "originId": "corpse-commodities-b",
          "counterOverrides": {},
          "type": null,
          "counters": {},
          "subtext": "",
          "description": "*Thanks to a combination of a large pack and numerous pockets and pouches, the Undead Peddler always seems to have something useful for sale.*\n\n- The Undead Peddler always has 12 Slots worth of uncannily useful items when encountered. These items vary from peddler to peddler, but they always manage to be useful for the location they are wandering in.\n- A few might stock potent imbued items or relics, though they are wary about showing these to the wrong type of customer.\n- Most Undead Peddlers are wired with explosives that they can detonate instantly when they are worried about being exploited. The explosives are powerful enough to destroy them and all their wares. Anyone within 1 Battlefield Area of the exploding Peddler feels the effect of the Bomb (p178).\n- Adds 1 Dark Allegiance Point.",
          "starValue": null,
          "valueSuffix": null
        },
        {
          "id": "65hQYThPeaFXzlQym0eH",
          "linkedValue": null,
