        },
        {
          "name": "Mini Mountain",
          "value": 0,
          "valuePrefix": null,
          "bonus": 0,
          "modifiers": [],
          "linkedValue": null,
          "order": 4,
          "id": "q131m5wT8pojoXrohDH2",
          "subtext": null,
          "counters": {},
          "originId": null,
          "counterOverrides": {},
          "type": null,
          "starValue": null,
          "valueSuffix": null,
          "description": "The Eruptle is Massive."
        },
        {
          "id": "0ieCblU5lSo7maf2yVoU",
          "description": "- On their Turn, the Eruptle can\nsubmerge, or erupt, from areas of\nsoft earth.\n- Whilst underground, the Eruptle gets a Speed Rating of Fast.\n- Whilst buried, the Eruptle is protected from physical Attacks.",
          "modifiers": [],
