      "abilities": [
        {
          "id": "Nvj2riYuWuZjTqxjfFpe",
          "modifiers": [],
          "linkedValue": null,
          "bonus": 0,
          "valuePrefix": null,
          "name": "Courageous Determination ",
          "value": 0,
          "description": "*Who needs training or experience when you have an indomitable spirit.*\n\nIf reduced to 0 Hearts, the Chosen One can attempt to shake off defeat.\n\n**Requires a Grit Check**\n- **Success:** The Chosen One springs back into action with 1 Heart restored.\n\nOnce a Session the GM can re-roll, or force a player to re-roll, if the result negatively impacts the Chosen One.\n\nThis even extends to rolls where the Chosen One isnt present. For example, to hinder the PCs from claiming a quest item that the Chosen One requires.",
          "valueSuffix": null,
          "starValue": null,
          "counterOverrides": {},
          "type": null,
          "originId": "courageous-determination",
          "subtext": "",
          "counters": {}
        },
        {
          "name": "Legendary Items",
          "value": 0,
          "id": "1g3hYq0c28PJIcrDV265",
          "modifiers": [],
          "linkedValue": null,
          "bonus": 0,
          "valuePrefix": null,
          "type": null,
          "counterOverrides": {},
          "originId": "legendary-items",
          "subtext": "",
          "counters": {},
          "description": "*Chosen Ones find themselves in possession of a handful of Imbued Items thanks to questing and older relatives with a habit of relic hoarding.*\n\n- Pick 3:\n  - **Red Edge:** This empowered sword is crafted from Flame Brass. It is a Master Weapon that does an additional Heart of Flame Damage upon a successful Attack.\n  - **Cleary Shield:** A Standard Shield made of Sun Gold. The bearer may also use the Parry granted by this item to nullify a Magical Ability targeted at them.\n  - **Spring Heel Boots:** Made of magical feathers which grants Supernatural Leaping (p107).\n  - **Mighty Mitten:** A mitt created from the paw of a powerful beast which grants Supernatural Might (p107).\n  - **Wooly Warm Tunic:** This endearing Extreme Weather Outfit (Cold) was woven from the legendary Wisdom Bumpos wool. Attacks that deal Flame or Frost Damage do one less Heart than usual.",
          "valueSuffix": null,
          "starValue": null
        },
        {
          "subtext": "While destiny ain’t what it used to be, it can still help out its agents in a pinch.",
          "counters": {},
          "name": "Favored By Fate",
          "value": 0,
          "modifiers": [],
          "description": "Once a Session the GM can reroll,\nor force a player to re-roll, if\nthe result negatively impacts the\nChosen One.\n\nThis even extends to rolls where\nthe Chosen One isn’t present. For\nexample, to hinder the PCs from\nclaiming a quest item that the\nChosen One requires.",
          "id": "YWZqM2r4pNHs5j507rFo"
        }
      ],
