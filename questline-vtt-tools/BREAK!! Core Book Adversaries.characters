      "bio": {
        "details": "**Mushroom Menace.** Funguy are an eccentric species of walking, talking toadstools. Thanks to a habit of keeping to themselves and a tendency towards ruthlessly expunging outsiders, very little is known about them.",
        "name": "Funguy",
        "background": "",
        "type": "Folk [PLant-kin]",
        "size": "Small",
        "characteristics": {
          "gender": "",
          "skin": "",
          "hair": "",
          "age": "",
          "weight": "",
          "eyes": "",
          "height": ""
        },
        "tokenCrop": "",
        "profileImage": null,
        "appearance": "",
        "subname": "Rank 0 Mook"
      },
      "allegiance": {
