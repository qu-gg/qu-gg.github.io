        {
          "counters": {},
          "subtext": null,
          "originId": "communication",
          "type": "Quick Facts",
          "counterOverrides": {},
          "starValue": null,
          "valueSuffix": null,
          "description": "Low Speech and\nanother language related to their\nhome region. They refuse to learn\nHoshi-Ban, the tongue of cats.",
          "value": 0,
          "name": "Communication",
          "valuePrefix": null,
          "bonus": 0,
          "linkedValue": null,
