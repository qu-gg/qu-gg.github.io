          "modifiers": [],
          "linkedValue": null,
          "bonus": 0,
          "valuePrefix": null,
          "name": "Tactics",
          "value": 0,
          "description": "Once an individual has been\ntargeted they will:\n- Use Back and Forth without a Fuss to avoid being cornered.\n- Fight relentlessly, but not with suicidal loyalty. After all, who will clean up the mess if they are killed?",
          "valueSuffix": null,
          "starValue": null,
          "type": "Quick Facts",
          "counterOverrides": {},
          "originId": "tactics",
          "subtext": null,
          "counters": {}
        }
      ],
      "abilities": [
        {
          "description": "*True maids take pride in their appearance, yet understand their uniform must be fit for the job at hand.*\n\n- Murder Maids wear Light Armor combined with an Appealing Outfit.\n- +2 Defense Rating.",
          "id": "j5kkoyfsU3CskM9LRciX",
          "modifiers": [],
          "linkedValue": null,
          "counterOverrides": {},
          "originId": "immaculate-uniform",
          "name": "Immaculate Uniform ",
          "value": 0,
          "subtext": "",
          "counters": {}
        },
        {
          "linkedValue": null,
          "modifiers": [],
          "id": "lsEvTPc0vSgAaWROnhFr",
          "description": "*Surviving enemies, like dirt and grime, are considered intolerable filth.*\n\n- Once per Turn the Murder Maid can expend 1 Heart to re-roll a failed Attack.\n- Murder Maids have a Minor Bonus (+2) on Checks and Contests connected to keeping things tidy.",
          "originId": "out-damn-spot",
          "counterOverrides": {},
          "counters": {},
          "subtext": "",
          "value": 0,
          "name": "Out Damn Spot "
        },
        {
          "valueSuffix": null,
          "starValue": null,
          "description": "*Battle Butlers are elegant combatants.*\n\n- Every Battle Butler has a Weapon Type they are proficient in. Using their Chosen Weapon provides:\n  - +1 Attack Bonus.\n  - +2 Defense Rating.\n  - A Battle Butlers Chosen Weapon has a Custom Ability (p160).",
          "counters": {},
          "subtext": "",
          "type": null,
          "counterOverrides": {},
          "originId": "tidy-battle-stance-a",
          "bonus": 0,
          "valuePrefix": null,
          "id": "uBiaKZXeyladc28PzMlQ",
          "linkedValue": null,
          "modifiers": [],
          "value": 0,
          "name": "Tidy Battle Stance [A]"
        },
        {
          "originId": "back-&-forth-without-a-fuss",
          "counterOverrides": {},
          "subtext": "",
          "counters": {},
          "name": "Back Forth Without Fuss ",
          "value": 0,
          "modifiers": [],
          "linkedValue": null,
          "description": "*Murder Maids zip from place to place with little effort.*\n\nMurder Maids have Supernatural Leaping.",
          "id": "JVbtMvguPHVT8uilkYF7"
        }
      ]
