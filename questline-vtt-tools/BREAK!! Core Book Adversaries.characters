        "abilities": [
          {
            "name": "Big 'Un",
            "value": 0,
            "subtext": "This Thing is immense.",
            "counters": {},
            "description": "This Thing is a Large Species.",
            "id": "bigun",
            "linkedValue": null
          },
          {
            "linkedValue": null,
            "id": "blubbery-hide",
            "description": "- +4 Defense Rating.\n- +1 Hearts Total.\n- Speed Rating is Slow.",
            "counters": {},
            "subtext": "This Thing's skin is tough.",
            "value": 0,
            "name": "Blubbery Hide"
          },
          {
            "id": "mighty-munch",
            "description": "- This creature's tusks/teeth/etc strike as a Mighty Weapon.\n- After a successful Attack, this creature can attempt to draw you into its mouth, if you are Medium-sized or smaller.\n\n**Requires a Might Contest**\n- Success: You’re Restrained in the creature's mouth.\n- You can attempt to escape at the beginning of each subsequent Turn by winning a Might Contest.\n- Inanimate objects, such as boulders, can be sucked into its mouth without a Contest.\n- If the creature begins its Turn with you in its mouth, it can:\n\n> **Gnaw**: Doing 1 Heart of Damage.\n\n> **Spit**: Firing you at a target up to 2 Battlefield Areas away. On a successful Attack, you and the target take 1 Heart of Damage and are Toppled. On a miss, you land 2 Battlefield Areas away and are Toppled.",
            "linkedValue": null,
            "value": 0,
            "name": "Mighty Munch",
            "counters": {},
            "subtext": "It can bite through rock!"
          }
        ],
