  },
  {
    "image": {
      "tokenCrop": {
        "unit": "%",
        "x": 0,
        "aspect": 1,
        "height": 100,
        "width": 100,
        "y": 0
      },
      "url": "https://firebasestorage.googleapis.com/v0/b/rpg-pbp.appspot.com/o/games%2F1WLk8WgaysyvKtNs5P0a%2Fimages%2FvJJUIWmQitWmlBD88XVl.png?alt=media&token=f9cbfba6-b909-4af7-adcf-891c8ef4d27a"
    },
    "name": "Service - Room & Board",
    "version": 1,
    "type": "none",
    "creator": "HwYLq98tYuY9lEEODMru3sEGeTM2",
    "id": "sOfqE5hqhVsrL18w4Tl7",
    "actions": [],
    "privacy": {
      "level": "private",
      "users": [
        "HwYLq98tYuY9lEEODMru3sEGeTM2"
      ]
    },
    "description": "The road is long and unforgiving. A bed and a well cooked meal is a simple, well-deserved luxury.\n\n- Room & Board will provide you with adequate food and sleep to avoid the effects of Starvation and Fatigue for a day.\n- More expensive establishments may include extra perks:\n - **Hearty Meal:** A big breakfast served alongside a fine beverage starts your day well. Gain an Edge on your first Insight roll of the day.\n - **Excellent Service:** Dedicated and friendly staff leave you feeling peppy. Gain an Edge on your first Aura roll of the day.\n\n**Basic**: 10 Stones a night.\n**Pleasant & Hearty**: 20 Stones a night.\n**Luxurious, Hearty, Excellent**: 10 Coins a night.",
    "data": {
      "type": "gear",
      "cost": {
        "gems": 10
      },
      "subtype": "services"
    }
  },
  {
    "image": {
