    }
  },
  {
    "description": "The most common shields are sturdy pieces of wood or metal that are held in place by a grip or strap along their back side.\n\n- You can Parry 1 Melee or Missile Attack per Fight. This includes spells or any special attacks that require an Attack roll.\n- Standard Shields require one hand to use, so they affect your ability to use two-handed weapons.\n\n**Defense Bonus**: +1",
    "data": {
      "cost": {
        "coins": 25
      },
      "subtype": "armor",
      "encumbrance": 1,
      "type": "Gear"
    },
    "creator": "HwYLq98tYuY9lEEODMru3sEGeTM2",
    "type": "none",
    "uses": {
      "max": 0
    },
    "privacy": {
