    },
    "version": 1,
    "name": "Weapon Ability - Dangerous"
  },
  {
    "version": 1,
    "name": "Weapon Ability - Disguised",
    "data": {
      "subtype": "weapons",
      "type": "Gear"
    },
    "description": "The weapon appears like a walking stick, jewelry, or other harmless item until carefully inspected or used. \n\n- Discerning this weapons real function requires a mistrustful person to make a successful Insight Check.\n\n**Coins** = Weapon Price +5",
    "uses": {
      "max": 0
    },
    "actions": [],
    "privacy": {
      "level": "private",
