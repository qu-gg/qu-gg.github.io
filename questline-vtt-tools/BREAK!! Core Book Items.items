    "id": "VK6hUq11qlhA0zyXGVU6",
    "creator": "HwYLq98tYuY9lEEODMru3sEGeTM2",
    "type": "none"
  },
  {
    "name": "Weapon Ability - Shoddy",
    "version": 1,
    "description": "Hastily and carelessly made, these weapons are easy on the purse but unreliable in battle. \n\n- These weapons are Sundered when you get an unmodified 1 or 2 on your Attack roll.\n\n**Coins** = (Weapon Price + Custom Ability Costs, if any) 2 (rounded up)",
    "data": {
      "type": "Gear",
      "subtype": "weapons"
    },
    "type": "none",
    "creator": "HwYLq98tYuY9lEEODMru3sEGeTM2",
