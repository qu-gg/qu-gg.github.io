      "cost": {
        "coins": 20
      }
    },
    "description": "While everyone understands Low Speech, much is spoken in native tongues.\n\n- You can attempt to communicate in the Journals featured language with a successful Insight Check."
  },
  {
    "name": "Other World Pocket Device",
    "version": 1,
    "image": {
      "url": "https://firebasestorage.googleapis.com/v0/b/rpg-pbp.appspot.com/o/games%2F1WLk8WgaysyvKtNs5P0a%2Fimages%2FaSDthEoMRhXZ4JIsx3WM.png?alt=media&token=008815e6-848c-4d2d-8148-5ec36e9c2935",
      "tokenCrop": {
        "unit": "%",
        "x": 0,
        "aspect": 1,
        "width": 100,
        "height": 100,
        "y": 0
      }
    },
    "description": "The Game Gal Advance, Peach Pod, and Wildberry Tablet are popular Other World devices intended for entertainment and communication. While you would assume these gadgets would cease to function across dimensions, this is not the case.\n\n- Strangely, in Outer World these devices work indefinitely without the need to charge.\n- These Devices can all snap photos, record audio, and make odd sounds or tunes on demand.\n- All Pocket Devices include a version of the Akenia Adventure!! videogame. The featured game worlds similarities to Outer World is uncanny, meaning it can be referred to as a Beginners Tome for queries regarding the ancient ruins and creatures of Outer World.",
    "data": {
      "subtype": "other world items",
      "type": "Gear",
      "encumbrance": 1
    },
    "type": "none",
    "creator": "HwYLq98tYuY9lEEODMru3sEGeTM2",
    "privacy": {
      "users": [
