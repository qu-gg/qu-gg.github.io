    "type": "none"
  },
  {
    "version": 1,
    "name": "Weapon Ability - Rapid Fire",
    "data": {
      "subtype": "weapons",
      "type": "Gear"
    },
    "description": "Reloading Mechanical Missile weapons in the middle of combat is an onerous task. This technological advancement reduces the need to do it quite SO often. \n\n- Only available for Large and Small Mechanical Missile Weapons. \n- Rapid Fire weapons may be fired 3 times before they need to be reloaded, which still takes 1 Action.\n\n**Coins** = Weapon Price x10",
    "uses": {
      "max": 0
    },
    "id": "ScqeA41KcVHTARA3yVBq",
    "actions": [],
    "privacy": {
      "level": "private",
