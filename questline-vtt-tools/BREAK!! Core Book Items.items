      "max": 0
    },
    "id": "MhApZXf9hcD7IxTAaltz",
    "name": "Armor Ability - Buoyant",
    "version": 1
  },
  {
    "name": "Armor Ability - Cargo",
    "version": 1,
    "data": {
      "type": "Gear",
      "subtype": "armor"
    },
    "description": "This armor has a built in storage space in a chest or back cavity to protect valuable, or easily damaged, items. \n\n- The armor provides you with an additional 3 Inventory Slots. \n- Any stowed items are protected from water, fire, and other physical trauma. \n- If the armor is destroyed, whatever is stored inside will fall out.\n\n**Coins** = Armor Price + 15",
    "id": "12w5KJdIjAEyFd93oOio",
    "uses": {
      "max": 0
    },
    "privacy": {
      "users": [
