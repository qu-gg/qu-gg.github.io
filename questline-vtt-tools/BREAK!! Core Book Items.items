    "actions": []
  },
  {
    "id": "2nI4ZoEWQvw6PilyzVjn",
    "privacy": {
      "level": "private",
      "users": [
        "HwYLq98tYuY9lEEODMru3sEGeTM2"
      ]
    },
    "uses": {
      "max": 0
    },
    "actions": [],
    "type": "none",
    "creator": "HwYLq98tYuY9lEEODMru3sEGeTM2",
    "data": {
      "subtype": "other world items",
      "encumbrance": 1,
      "type": "Gear"
    },
    "description": "These pointy-harm-sticks are not dissimilar to the pistols already in use in Outer World, though these can fire shots in rapid succession. These pistols function as Small Mechanical Missile Weapons, with the following differences\n\n**Weapon Ability**, Ammo Magazine:\n\n- This firearm holds 10 bullets that can be discharged at a rate of one per Turn, before requiring 1 Action to Reload.\n- Other World Sidearms begin with 10 Other World Bullets. These cannot be bought, but must be manufactured by a Gadgeteer able to craft Advanced Items.",
    "name": "Other World Sidearm",
    "version": 1
  },
  {
