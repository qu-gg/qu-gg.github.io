      ]
    },
    "creator": "HwYLq98tYuY9lEEODMru3sEGeTM2",
    "type": "none"
  },
  {
    "version": 1,
    "name": "Weapon Ability - Secret Compartment",
    "data": {
      "type": "Gear",
      "subtype": "weapons"
    },
    "description": "A small gadget, or hidden cavity, can be incorporated into the pommel, grip or guard of a weapon.\n\n- A Secret Compartment allows you to stow small items like one dose of a consumable, a gem, or a folded treasure map.\n- If you opt to add a gadget, it must be small enough to be incorporated into the weapon, for example a compass on the pommel of a cutlass.\n\n**Coins** = Weapon Price + 5",
    "privacy": {
      "level": "private",
      "users": [
        "HwYLq98tYuY9lEEODMru3sEGeTM2"
      ]
    },
    "actions": [],
