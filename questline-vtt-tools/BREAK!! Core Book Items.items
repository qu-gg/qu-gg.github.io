    "version": 1,
    "name": "Solvent",
    "creator": "HwYLq98tYuY9lEEODMru3sEGeTM2",
    "type": "none",
    "privacy": {
      "users": [
        "HwYLq98tYuY9lEEODMru3sEGeTM2"
      ],
      "level": "private"
    },
    "id": "Ihvlyra7OiyvE6TjNVJz",
    "actions": [],
    "uses": {
      "max": 0
    },
    "description": "Acids and other caustic liquids. 1 Unit of Solvent will do 2 Hearts of Damage to any objects classified as less than Very Hard. This is roughly equivalent to burning a hole through floorboards. \n\n- In a Fight, you can splash Solvent on an enemy with a successful Attack roll. 1 Unit will cause a Caustic/Burning Injury.",
    "data": {
      "encumbrance": 1,
      "type": "Gear",
      "cost": {
        "coins": 20
      },
      "subtype": "combustibles & chemicals"
    }
  },
