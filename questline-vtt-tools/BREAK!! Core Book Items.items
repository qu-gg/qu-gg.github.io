    ],
    "type": "none",
    "data": {
      "cost": {
        "coins": 20
      },
      "subtype": "Illumination",
      "type": "Gear",
      "encumbrance": 1
    },
    "image": {
      "url": "https://firebasestorage.googleapis.com/v0/b/rpg-pbp.appspot.com/o/games%2Fn9qXCE2Ylwj8dBmy4lpo%2Fimages%2FLD3P3BtTba2MbQb4C5hd.png?alt=media&token=c80dafc8-f820-40f4-8cbd-0eafbd78ff56",
      "tokenCrop": {
        "y": 0,
        "width": 100,
        "aspect": 1,
        "x": 0,
        "height": 100,
        "unit": "%"
      }
    },
    "actions": [],
    "creator": "",
    "description": "A portable container for one of the small, glowing oozes that populate the Buried Kingdom. These Lanterns are valued for their simple maintenance and dependability. Available in a variety of colors, some even change hues.\n\n- A quick tap of the container will rouse the Slime and, once agitated, it will change from a dull glow to a bright light in seconds.\n- Lumi-Slimes must eat 1 Unit of Rations a week or they’ll die. A regular handful of small bugs or similarly sized chunks of monster flesh will also work.\n- Over time, slimes can erode most materials and must be kept in their resistant container.\n- If your Lumi-Slime escapes, or is set free, over time they will grow into a Goop.",
    "id": "zksi64UHZrZ4XAFNGmwG"
  },
  {
    "name": "Torch",
