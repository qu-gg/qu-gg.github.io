        "height": 100,
        "width": 100
      }
    },
    "version": 1,
    "name": "Grenade",
    "creator": "HwYLq98tYuY9lEEODMru3sEGeTM2",
    "type": "none",
    "uses": {
      "max": 1
    },
    "privacy": {
      "level": "private",
