      "abilities": [
        {
          "id": "cwhAQZR4crQsS3uNLO14",
          "name": "Colloid Corpus.",
          "description": "Same as Goops (p383).",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "ETF1dQfJZ0UjVdyzG23l",
          "name": "Diminutive Killer.",
          "description": "As Small Creatures (p106), Lurki-slime prefer to attack from the unseen shadows, striking with the teeth and bones collected from their former prey as a Concealed Weapon.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "UdVdHN6MmUZD6KBzLCzv",
          "name": "Patient Predator.",
          "description": "Lurki-slime are natural predators, frequently waiting for their prey with uncanny stillness which makes them incredibly difficult to spot at first. Attempts to identify their hiding places suffer a Snag.",
          "value": 0,
          "counters": {},
          "modifiers": []
        }
      ],
