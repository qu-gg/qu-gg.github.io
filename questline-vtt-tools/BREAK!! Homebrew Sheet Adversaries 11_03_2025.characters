      "abilities": [
        {
          "id": "Ksl6N5JfeV9veVFy1QAk",
          "name": "Putrid Predator [A].",
          "description": "- The sewer gator is Massive.\n- +6 to Defense\n- Sweep Attack: Tail can flail to strike as an Arc Weapon.\n- Focus Attack: Jaw can strike as a Mighty Weapon.\n\nAfter a successful Focus Attack, the sewer gator can clamp its jaws around a creature if it\u2019s Medium-sized or smaller.\nRequires a Might Contest, on Success the Target is Restrained in the gator\u2019s teeth. The Target can attempt to escape at the beginning of each subsequent Turn by winning a Might Contest.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "jWvDqSRANuKrXPLN24ZR",
          "name": "Contaminated Regeneration [A].",
          "description": "The Sewer Gator regains a Heart each Turn while in water or other environments that are contaminated.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
