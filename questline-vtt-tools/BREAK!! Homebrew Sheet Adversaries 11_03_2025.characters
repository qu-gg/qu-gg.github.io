      "abilities": [
        {
          "id": "yvhhNG4vuKu7Pdk6F3CR",
          "name": "Aerial Mouthful.",
          "description": "Being blindly carried thousands of feet into the air by your head is rather terrifying though, admittedly, efficient.\r\nThe Aero Chomp can provide 1 Day's worth of Travel over Difficult or Impassable Terrain.\r\nThis in exchange for 1 Stack of Fatigue, as the Aero-Chomp siphons the energy of its passenger.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "3zZh9oYZgAlvY8qDzT5N",
          "name": "Sleep's Embrace.",
          "description": "It won't kill you but it will leave you stranded and weary.\r\nIf threatened, the Aero-Chomp will use its Action to engulf a Target's head. On a Successful Hit, the Aero-Chomp will Blind the Target and inflict 1 Stack of Fatigue. While attached, on subsequent Turns, it will inflict additional stacks of Fatigue. Requires a Might Contest to remove.",
          "value": 0,
          "counters": {},
          "modifiers": []
        }
      ],
