        "max": 1,
        "meterType": "hidden",
        "temp": 0
      },
      "actions": [
        {
          "type": "weapon",
          "version": 2,
          "id": "Eg8El4UQ8Ztb2FOaKttq",
          "displayName": "Whimsical Weapon",
          "details": [
            {
              "value": {
                "description": "Range: Melee\nDamage: 1\nThreshold: 20"
              },
              "type": "description",
              "visibility": "full"
            },
            {
              "value": {
                "image": {
                  "tokenCrop": {
                    "x": 0,
                    "height": 100,
                    "unit": "%",
                    "aspect": 1,
                    "y": 0,
                    "width": 100
                  },
                  "url": "https://firebasestorage.googleapis.com/v0/b/rpg-pbp.appspot.com/o/games%2Fn9qXCE2Ylwj8dBmy4lpo%2Fimages%2FYm5Yte0sUUWUo8Yy32du.png?alt=media&token=8db28edf-a753-49db-9212-35430deb5e87"
                }
              },
              "visibility": "full",
              "type": "image"
            }
          ],
          "effects": [
            {
              "encounterRoll": false,
              "name": "",
              "advantageType": "none",
              "modifiers": [
                {
                  "linkedValue": "attack-bonus.attributes.attack-bonus.value.value",
                  "operator": "add"
                }
              ],
              "hide": false,
              "useModifiers": true,
              "baseRoll": "1d20",
              "quantity": 1,
              "type": "roll",
              "bonus": 0,
              "selectedDie": "d20",
              "bonusRoll": ""
            }
          ]
        }
      ],
      "abilities": [
        {
          "id": "ieQBOcn9zyVViuugJGFr",
          "name": "Living Cartoon [B].",
          "description": "A Toon Goon is the living embodiment of whimsy. The rules of reality don't fully apply to them.\n\n- The Cartoon Slapstick rules apply to the Toon Goon at all times, both for themselves and their victims.\n- They may choose whether or not they're affected by a Whimsy Stone, based on whichever they would consider is the funniest outcome. The GM decides how this works exactly.\n- If they would begin to fall, they may attempt an Insight Check. If they succeed, they fall as normal, but if they fail, then they haven't noticed they should be under the effects of gravity and may continue as though still on solid ground. They must attempt this Check every Round that they're defying gravity.\n- They can only be killed permanently through the use of turpentine or a similar solvent that would dissolve paint.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "SHii7j6bYFj6ftRLXYV2",
          "name": "Supernatural Humour [B].",
          "description": "A Toon Goon breaks so many laws of reality it's hard to keep track. Usually, this is in service of some gag and if it stops being funny, it often stops working.\n\nA Toon Goon may choose to act as though they have Supernatural Might, Supernatural Leaping, or Supernatural Will (though only one at a time) for a single Action, but only if having that Ability in the current situation would be funny. For example, they couldn't have Supernatural Might to simply bash down a door, but they could have it to enable one that resembles a tiny Squeaker to arm wrestle a giant.\n\nIf the party (not the GM) decide that what they've attempted isn't funny, then it immediately backfires.",
          "value": 0,
          "counters": {},
          "modifiers": []
        }
      ],
      "speed-rating": {
        "attributes": {
          "speed-rating": {
            "value": {
              "visible": true,
              "value": 1
            }
          }
        }
      },
      "allegiance": {
        "attributes": {
          "allegiance": {
