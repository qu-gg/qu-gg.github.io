      "abilities": [
        {
          "id": "i0bMQqbBrSHZw2zNPnSb",
          "name": "False Appearance [B].",
          "description": "While the gargoyle remains motionless, it is indistinguishable from an inanimate object.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "M6Vc2WIYlQUvWDCJWDDb",
          "name": "Faultless Tracker [B].",
          "description": "The creature that caused the gargoyle to animate becomes its \u201cquarry\u201d. The Gargoyle knows the direction and distance to its quarry as long as they are within 160 feet of its protected location or the Gargoyle is destroyed.\n\nInorganic creatures like Bio Mechanoids don\u2019t seem to trigger this, though.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "IWyntL3pcpcmhxXANKQm",
          "name": "Rejuvenation [B].",
          "description": "If the Gargoyle is destroyed, it reforms with all of its Hearts in 1 hour unless its remains fully disintegrated or turned to dust.",
          "value": 0,
          "counters": {},
          "modifiers": []
        }
