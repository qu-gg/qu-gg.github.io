        {
          "id": "Ilp86XLiDivAFQDIKRTZ",
          "name": "Life Drain.",
          "description": "Once a creature is restrained by the Bog Willow's tendrils, the tree can drain its life force. The restrained creature must make a Grit Check or take 1 Damage, which the Bog Willow uses to heal itself 1 Heart.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "oMZHg4d18layxJ12Ki6Y",
          "name": "Rooted.",
          "description": "The Bog Willow is immobile, rooted deeply in the swamp. While this makes it difficult to move, it also grants it resistance to being knocked back or moved by force. It gains +2 Hearts drawing life from its roots.",
