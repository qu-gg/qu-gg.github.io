      "abilities": [
        {
          "id": "PpLDoQbOn0SvwId2CKRU",
          "name": "Shadow Shot.",
          "description": "Small, but rapid fire, magical blast. Once per Turn, may Attack with magical energy as a Thrown Weapon. Deals Dark damage.\r\nAdds 1 Dark Point",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "wZ9q8Ef9mIhHUDFpyVuz",
          "name": "Shadow Burst.",
          "description": "Attempt to throw a burst of shadow magic up to 2 Areas away. That area is filled with dark fog and gains the Obscured condition for 3 Rounds, counting as caused by darkness. \nShadowy tendrils also lash at foes as the burst connects. Contest with up to 2 Targets in the area, Aura vs Target Deftness. On Success, deal 1 Dark Damage.\nAfter firing the Shadow Burst, the mage cannot use any magic Abilities on their next Turn.\nAdds 1 Dark Point.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "y4287wWwhQNXVPYkPYxm",
          "name": "Shadow Walk.",
          "description": "The Shadowmage may attempt to become silent and unseen.\nThe Shadowmage must first spend one Turn weaving a haze of magic that begins to hide them from view.\nThe mage becomes invisible and totally silent for 3 turns. When they Attack or use a Magical Ability they will become visible again.\nAfter casting Shadow Walk, the mage cannot use any Magic Abilities on their next Turn and cannot Shadow Walk again for 6 Turns.\nAdds 1 Dark Point.",
          "value": 0,
          "counters": {},
          "modifiers": []
        }
      ],
