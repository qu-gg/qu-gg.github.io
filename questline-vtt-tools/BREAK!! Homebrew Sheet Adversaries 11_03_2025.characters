      "actions": [],
      "abilities": [
        {
          "id": "LMzntVoFUUpWagBAHzqk",
          "name": "Titan of Industry.",
          "description": "Can only be used on PC's still on the floor in the same Area as a leg. Attacks:\nSmash: 1 Target, dealing 3 Damage\nKick: 1 Target, dealing 2 Damage and Knockbacked from the Area",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "XXLubh3g6rJKsfxkop35",
          "name": "Workplace Accident.",
          "description": "Refuse Dump: The Maker sprays out the effluence of production to the sides and behind it to discourage flanking. Can be sprayed up to 1 Area away. PC's within the Area must make a Deftness Check or be Restrained by their legs, requiring a Might check as an Action. An Area targetted more than once becomes Suffocating as the levels of waste grow deeper.\nShuddering Gait: Any PC on a Strike Point must make a Might Check or fall off The Maker. Fall Damage at GM's discretion.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "4Ahf7rTKDAwixJWZPGG4",
          "name": "Repair Protocol.",
          "description": "+8 Defence\r\nEvery 3 Turns, The Maker heals 1 Heart to ALL Strike Points unless destroyed.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "ByW3LW6xZNFfnmk4GgUR",
          "name": "Major Payne.\nTown killer cannon. 20 Damage on Hit.\n1 Turn to open the housing. 3 Turns to charge the Attack. Fires on 3+ Areas away from The Maker.\n\nGM Note: End of campaign boss. This is a purely thematic ability, to give them a countdown when players are being slow. E.g., we're 3 hours out from the town, we need to get in there and shut it down. I can see the town. We're in range!",
          "description": "THE BATTERIES ARE CHARGING!!",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "Ud5GVVZ1pieLRg33LGAz",
          "name": "Drone Swarm.",
          "description": "As an Action, The Maker can summon a Drone. The GM can decide what kind of Drone. This Ability has a 2 Turn Cooldown.",
          "value": 0,
          "counters": {},
          "modifiers": []
        }
      ],
