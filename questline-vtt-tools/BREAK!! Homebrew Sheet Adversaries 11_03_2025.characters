      "inventory": {
        "maxEncumbrance": 0,
        "items": [
          {
            "id": "amWtH8dwlywppxdXgU1v",
            "itemId": "FZs3MP0TZ4reO9ghdnfg",
            "name": "1d2 Bright Dew",
            "description": "Bright Dew.\n10 of these can be mixed together over the course of 1 minute to create a Bright Dew Potion.",
            "type": "none",
            "privacy": {
              "level": "public",
              "users": []
            },
            "creator": "",
            "data": {
              "cost": {
                "coins": 1
              },
              "encumbrance": 10.0
            },
            "version": 0,
            "owners": [],
            "quantity": 1,
            "equipped": false,
            "isCustom": true,
            "actions": []
          }
        ],
        "currency": {}
      },
      "attack-bonus": {
        "attributes": {
          "attack-bonus": {
            "value": {
              "visible": true,
              "value": 0
            }
          }
        }
      },
      "notes": [
        {
          "description": "Bristles are dedicated only to vigorous attack. They know nothing of strategy and, without an outside force to guide them, will simply rush forwards and attack the first foe they encounter. They are thus easily led into traps or otherwise exploited. They are however, suicidally brave, and will not flee on any account.\r\nIf fled from, they will put up a good chase but only for a short while.",
          "counterOverrides": {},
          "rollDetails": [],
          "id": "DBMa0akRFxeJjA4o7MVe",
          "type": "Quick Facts",
          "originId": "tactics",
          "counters": {},
          "modifiersPostCalculationFunc": null,
          "modifiers": [],
          "linkedValue": null,
          "name": "Tactics",
          "value": 0
        },
        {
          "counters": {},
          "counterOverrides": {},
          "type": "Quick Facts",
          "rollDetails": [],
          "linkedValue": null,
          "modifiersPostCalculationFunc": null,
          "description": "Speaks Low Speech and Bright Speech. Limited intellect means it will only ever issue violent challenges and battle cries.",
          "name": "Communication",
          "modifiers": [],
          "value": 0,
          "id": "Ntrz5p3hvUCRqLHi17zk",
          "originId": "communication"
        },
        {
          "rollDetails": [],
          "id": "vhRuuxAZkiU0q109rpWa",
          "description": "A dark, or even a twilight, version of bristle could exist. They would need different damage types and a change to their behaviour to suit their alignment.",
          "type": "Quick Facts",
          "counterOverrides": {},
          "name": "Customization",
          "modifiers": [],
          "value": 0,
          "modifiersPostCalculationFunc": null,
          "originId": "customization",
          "linkedValue": null,
          "counters": {}
        },
        {
          "rollDetails": [],
          "value": 0,
          "name": "Habitat",
          "description": "Bristles are quite common in some parts of The Blazing Garden, where they are a regular threat to travellers and rural communities. They don\u2019t often attack settlements, but can be found wandering open fields and hills where the sunlight is bright.",
          "id": "cjG1nkOm4vkZPU7IEdlU",
          "originId": "habitat",
          "linkedValue": null,
          "type": "Quick Facts",
          "counterOverrides": {},
          "modifiers": [],
          "modifiersPostCalculationFunc": null,
          "counters": {}
        },
        {
          "type": "Quick Facts",
          "value": 0,
          "linkedValue": null,
          "modifiersPostCalculationFunc": null,
          "counters": {},
          "description": "Bristle do not really have personalities or thoughts, they are like little machines with only one focus. Usually that is patrolling the fields to find creatures to attack. They understand speech and can speak, but they don\u2019t converse. They will speak only to shout battle cries or curse their enemies.\r\nBristle under the influence of other bright infused plant creatures will behave in different ways suiting the influence those creatures are exerting on them, but they will never be truly sentient.",
          "name": "Role Playing Notes",
          "counterOverrides": {},
