        "meterType": "hidden",
        "temp": 0
      },
      "actions": [],
      "abilities": [
        {
          "id": "aioVYvcXYJUevgWXk4GE",
          "name": "Perfect Mimicry [B].",
          "description": "A Copykitt is completely indistinguishable from whatever it's disguised as at first glance, and sometimes even with more in-depth inspection. Though it takes a long time, they can even change their shape and colouration to look like another kind of trap.\n\nCopykitts automatically succeed on any Check or Contest to disguise themselves as a trap of some description. If they are hidden in a room, a Creature searching for traps automatically believes that they have found a real trap unless they found it with a Special Success. If a Creature chooses to inspect a Copykitt further, a successful Check reveals the truth.\n\nA Copykitt may change its appearance to resemble a different kind of trap without needing to make a Check. This process takes 1 hour to complete, during which time the Copykitt is very obviously a fake. They may also change their size as part of this change, choosing to be Small, Medium or Large. Every step up or down in Size adds an additional hour to the process.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "fAdKkTUhtPsUGPmQhdB4",
          "name": "Clingy Climber [B].",
          "description": "Copykitts secrete a sticky substance that allows them to adhere to any surface. While it's not strong enough to restrain a creature, it does allow them to climb up and across any kind of surface, even across ceilings.\n\nCopykitts ignore the Isolated and Precarious Area Conditions. They may move across any solid surface that can hold their tiny weight, regardless of gravity.",
          "value": 0,
          "counters": {},
          "modifiers": []
        }
      ],
