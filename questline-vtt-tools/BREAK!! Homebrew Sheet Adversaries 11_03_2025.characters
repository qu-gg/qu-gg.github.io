      "notes": [
        {
          "type": "Quick Facts",
          "value": 0,
          "linkedValue": null,
          "modifiersPostCalculationFunc": null,
          "counters": {},
          "description": "The Lost stalks its prey for severl hours, allowing itself to be heard while maintaining a great deal of distance. It waits until a group of foes is preoccupied with something else, then chrages in, ideally approaching under cover, and attempts to grab the nearest Creature like a lost 5yo grabbing a stranger at the mall.\n\nOnce it has a Creature Restrained, it does nothing unless attacked, at which point it will continue attacking its Restrained Creature. The Lost releases a Restrained Creature that falls unconscious and pursues the nearest for that is not incapacitated.",
          "name": "Role Playing Notes",
          "counterOverrides": {},
