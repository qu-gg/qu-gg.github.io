      },
      "notes": [
        {
          "description": "Shadowmages aim to use cunning whenever possible. They will attempt to get the most out of their Shadow Walk power, but it is limited by its short duration.\r\n",
          "counterOverrides": {},
          "rollDetails": [],
          "id": "DBMa0akRFxeJjA4o7MVe",
          "type": "Quick Facts",
          "originId": "tactics",
          "counters": {},
          "modifiersPostCalculationFunc": null,
          "modifiers": [],
          "linkedValue": null,
          "name": "Tactics",
          "value": 0
        },
        {
          "value": 0,
          "modifiersPostCalculationFunc": null,
          "name": "Combat Gear",
          "id": "AdV2VUGGxlLp3oS0OFPO",
          "counterOverrides": {},
          "linkedValue": null,
          "counters": {},
          "rollDetails": [],
          "description": " Light Armour and a Standard Weapon.\r\n",
          "type": "Quick Facts",
          "originId": "combat-gear",
          "modifiers": []
        },
        {
          "counters": {},
          "counterOverrides": {},
          "type": "Quick Facts",
          "rollDetails": [],
          "linkedValue": null,
          "modifiersPostCalculationFunc": null,
          "description": "They speak and understand Low Speech and a language appropriate to their region. Shadowmages tend to like to keep quiet, not speaking unless they feel it is strictly necessary.\r\n",
          "name": "Communication",
          "modifiers": [],
          "value": 0,
          "id": "Ntrz5p3hvUCRqLHi17zk",
          "originId": "communication"
        },
        {
          "rollDetails": [],
          "id": "vhRuuxAZkiU0q109rpWa",
          "description": "A shadowmage could be altered to be a mist weaving druid or a wizard weaving deceitful illusions.\r",
          "type": "Quick Facts",
          "counterOverrides": {},
          "name": "Customization",
          "modifiers": [],
          "value": 0,
          "modifiersPostCalculationFunc": null,
          "originId": "customization",
          "linkedValue": null,
          "counters": {}
        },
        {
          "rollDetails": [],
          "value": 0,
          "name": "Habitat",
          "description": "A Shadowmage might be found anywhere, but they are most common outside of the Brilliant Garden. They often work as mercenaries or agents. Some are part of organised guilds or military forces.\r",
          "id": "cjG1nkOm4vkZPU7IEdlU",
          "originId": "habitat",
          "linkedValue": null,
          "type": "Quick Facts",
          "counterOverrides": {},
          "modifiers": [],
          "modifiersPostCalculationFunc": null,
          "counters": {}
        },
        {
          "type": "Quick Facts",
          "value": 0,
          "linkedValue": null,
          "modifiersPostCalculationFunc": null,
          "counters": {},
          "description": "Shadowmages like to remain calm and collected. They want to seem professional, but are a bit too inclined towards looking cool.\r",
          "name": "Role Playing Notes",
          "counterOverrides": {},
          "rollDetails": [],
          "originId": "role-playing-notes",
