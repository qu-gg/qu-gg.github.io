      "abilities": [
        {
          "id": "mbTbWqS1s5ChW1Uf7iI1",
          "name": "Swarming Bite.",
          "description": "The Mire Leech Swarm attacks in unison, covering a Target in a mass of biting leeches. The Target must make a Grit Check or be paralyzed due to the combined venomous bites. The Target can make new Grit Checks as an Action on their following Turns.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "tvVmTy5OBh1C5n3wWMUo",
          "name": "Blood Drain.",
          "description": "Once a target is paralyzed or incapacitated, the Mire Leech Swarm can drain 1 Heart per Turn. This also heals the swarm by the same amount, making it difficult to eliminate.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "Y3HY1gvi3VhJcXTdj393",
          "name": "Amphibious Swarm.",
          "description": "The Mire Leech Swarm is most dangerous when submerged, where it can move with alarming speed.\nMire Leech Swarms are immune to ailments.\nMire Leech Swarms can only be hit by Attacks made with large broad objects or that target the entire Area the swarm occupies. Your GM will decide which objects or strikes will make significant impact on the swarm.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "ZPWevVZMs7YEO0ZwdxJG",
          "name": "Scared of Muckgrowls.",
          "description": "Mire Leech Swarms have a Snag to all actions when in the same Area as a Muckgrowl",
          "value": 0,
          "counters": {},
          "modifiers": []
        }
      ],
