      "abilities": [
        {
          "id": "in0DYSI747wY0bDTCeeu",
          "name": "Snark Attack.",
          "description": "If the Snark is moving underground, it can jump 2 Areas and Attack a Target in the Area in-between their starting and final position with a Minor Bonus. This Ability only works on their first Attack on a Target, unless the first Attack is an Ambush, which then allows the Ability to be used twice. Subsequent use of this Ability on a Target is subject to Diminishing Returns.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "ly9MGGxoNmBxXnIf4PaQ",
          "name": "Sawtooth.",
          "description": "The first time a Target receives Damage from a Snark during a Fight, a random limb of theirs becomes wounded. Any Action with said limb has a Minor Penalty for the remainder of the Fight. A Target can only be affected by one instance of this Ability, and on one limb.",
