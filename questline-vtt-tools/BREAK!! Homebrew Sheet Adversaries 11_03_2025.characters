      "abilities": [
        {
          "id": "ExijdS03nj9TfCgCJrb1",
          "name": "Energy Absorption.",
          "description": "The Glimmerback passively absorbs energy from its surroundings, charging the gem on its back. After 2 Turns of charging, the gem reaches full power, providing a +2 Bonus to its Defense Rating until the energy is released.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "gw9OsMTdEsBZ8fKMiooJ",
          "name": "Radiant Flash.",
          "description": "Once fully charged, the Glimmerback can release a blinding flash of light, affecting all Creatures within the same Area. Creatures must make an Insight Check or be Blinded.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "boIexmNRXm6IhTz0v5zw",
          "name": "Light Beam.",
          "description": "Instead of a Radiant Flash, the Glimmerback can focus the stored energy into a concentrated light beam. This attack Targets a single enemy within 2 Areas, has a +6 to hit, and deals 3 Damage on a successful strike.",
          "value": 0,
