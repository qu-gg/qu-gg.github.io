      "abilities": [
        {
          "id": "9ACbwTewwnffpayzW3MH",
          "name": "Triple Threat.",
          "description": "Adult Dragons are Massive. In addition to moving, the Dragon can take three Actions each turn, each being performed by different parts of its body. While this is mostly used to Attack, the GM may decide the Dragon can do other things as well.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "d0b5514krvWFgLEYlBkb",
          "name": "Head.",
          "description": "Bite, Elemental Breath, React, Defend\nBody. Claws, Defend, Extra Move, Attack Assist\nTail. Defend, Attack Stunt, Combat Trick.\nThe Dragon cannot target the same foe with multiple attacks, but can use attack assists against one target.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "zylw0SrJ5qsp3Nr0qqNr",
          "name": "Elemental Breath, Fire.",
          "description": "The Dragon can breathe into two Areas which must be adjacent to each other, and one of which must be the Dragon\u2019s Area or adjacent to it.\nImpact. All Creatures must make a Deftness Check or take 2 Damage.\nOngoing. if the Area had anything flammable, it becomes Hazardous",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "AaJoogvKuOonVQHLovkV",
          "name": "Hurricane Wings.",
          "description": "Dragons can fly, and are Fast so long as they can use their wings. Any Creatures in an Area the Dragon takes flight from must make a Might Check or be Toppled due to the massive downdraft as the Dragon takes off.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "zV4qKHxLRuaxPSdWNY4W",
          "name": "Terrifying Roar.",
          "description": "On the Dragon\u2019s first Turn in combat, it can unleash a roar in addition to its other Actions. Every Creature must win a contest (Dragon\u2019s Aura vs. Grit) or be Terrified. Shaking off the fear requires an Action and a successful Grit Check (or an action and a successful Aura Check from an ally in the same Area).",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "l7J5BnzegqTII6V5YfDy",
          "name": "Supreme Arrogance.",
          "description": "Edge on Aura Checks, as well as Grit Checks in Negotiations.",
          "value": 0,
          "counters": {},
          "modifiers": []
        }
      ],
