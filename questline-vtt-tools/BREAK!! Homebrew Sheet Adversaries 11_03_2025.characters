    "activeSheet": "eDj3Wn10tM6E1nKzpC3T",
    "isActive": true,
    "name": "[0] Toon Goon",
    "version": 9,
    "image": {
      "tokenCrop": {
        "unit": "%",
        "aspect": 1,
