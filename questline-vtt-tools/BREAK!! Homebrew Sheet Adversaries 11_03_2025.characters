        {
          "id": "amJfRXbUNPTvVRpxPIvh",
          "name": "Dark Reflection.",
          "description": "A Creature sees The Envious as a Medium-sized duplicate of itself, wearing the same equipment and wielding the same weaponry. In addition, if a Creature is invisible to or untargetable by The Envious, The Envious is also invisible to or untargetable by that Creature.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "yU2p7Q4Jkx6KuQLVUzG5",
          "name": "Envious Replication.",
          "description": "If a Creature within 1 Area casts a Spell or uses an Ability, The Envious learns to emulate that Spell or Ability and can use it once, at which point it must see the Action used again in order to emulate it again.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "n2NZLGSQ1qwIZjAD5BGp",
          "name": "Extreme Envy.",
          "description": "While a Creature within 1 Area is affected by a beneficial effect, The Envious is also affected by that effect.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "Ap3O0RH3HtqzmOk350Vy",
          "name": "Magic Resistance.",
          "description": "The Envious has an Edge on all Checks made to resist Magical Effects.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "isHJZ3WcT4rfj6iO39Ic",
          "name": "Instant Replication.",
          "description": "Once per Round, The Envious can immediately cast a Spell or use an Ability when it learns to duplicate it with its Envious Replication Ability.",
          "value": 0,
          "counters": {},
          "modifiers": []
        }
      ],
