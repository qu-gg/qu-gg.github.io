      "notes": [
        {
          "type": "Quick Facts",
          "value": 0,
          "linkedValue": null,
          "modifiersPostCalculationFunc": null,
          "counters": {},
          "description": "One often comes upon The Hungry mid-gorging, though they always break off to pursue fresh prey. The Hungry attacks teh creature with the most Hearts, attacking with claws and attempting to swallow it whole once it drops.\n\nIf the Creature has no Injuries, The Hungry does not make a second attempt, instead going after the Creature who has the next highest amounts of Hearts.",
          "name": "Role Playing Notes",
          "counterOverrides": {},
          "rollDetails": [],
          "originId": "role-playing-notes",
