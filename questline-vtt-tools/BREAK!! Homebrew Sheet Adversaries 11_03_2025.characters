      "actions": [
        {
          "displayName": "Leg Slam",
          "id": "w1BJOP373Fbcu20E0pkk",
          "version": 2,
          "type": "Weapon",
          "effects": [
            {
              "encounterRoll": false,
              "modifiers": [
                {
                  "linkedValue": "attack-bonus.attributes.attack-bonus.value.value",
                  "operator": "add"
                }
              ],
              "quantity": 1,
              "hide": false,
