      "abilities": [
        {
          "id": "Mvj00YtMokFWFjvMv752",
          "name": "Split.",
          "description": "If a Creature is dealt an Injury while within 4 Areas of The Dolorous, it splits into two, with half of the total remaining Hearts each.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "Iul2HVf45dGhgIMaL10U",
          "name": "Vicious Cycle.",
          "description": "The Dolorous makes Attacks with an Edge and deals an additional 1 Damage if it is within 2 Areas of another Dolorous it can see.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "vAI5Yx3Z2laSHQhTJuzB",
          "name": "Dolorous Counter.",
          "description": "If a Creature within 4 Areas hits it with an Attack and The Dolorous can see it, the Creature has to make a Grit Check with a Snag.\n\nFailure: the Creature takes Dark Damage equal to the difference between its current Hearts and Hearts Total, rounded down. This will always deal at least 1 Damage, however it cannot reduce a Creature's Hearts to 0.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "4A85vjtvmPOOpJwDb3nK",
          "name": "Repentance.",
          "description": "Once per Round, if a Creature within 4 Areas forces The Dolorous to make a Check or Contest and it fails, The Dolorous instead succeeds and rolls a d20.\n\nOn a 10 or lower, The Dolorous teleports to the same Area as the Target and makes 2 Cleaver Attacks against that Creature.",
          "value": 0,
          "counters": {},
          "modifiers": []
        }
      ],
