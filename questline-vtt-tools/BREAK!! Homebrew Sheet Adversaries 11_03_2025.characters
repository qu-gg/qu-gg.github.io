      "abilities": [
        {
          "id": "S7DdEpNKEIyKwy1cVgKB",
          "name": "Trash Panda.",
          "description": "Snatchers have an Edge on all Deftness Checks and Contests involving stealing or trying to break into things or places.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "G4sGRMleI7M4Ohmwv9ZC",
          "name": "Raccoon-Like.",
          "description": "A Snatcher looks remarkably similar to a large raccoon. In conditions that limit visibility (such as darkness) or when a Snatcher is intentionally trying to blend in with raccoons, an observer must pass an Insight Check to realise the Snatcher is not a raccoon.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "MwB00bZEdx0KLibR9hQI",
          "name": "Shadow Sight.",
          "description": "Snatchers can see in darkness and do not require a Torch.\r\nThey are immune to the Obscured battlefield condition when caused by darkness.\r\nUnlike Underdwellers, they do not suffer a penalty in daylight.",
          "value": 0,
          "counters": {},
          "modifiers": []
        }
