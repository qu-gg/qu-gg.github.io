      "abilities": [
        {
          "id": "mtbt7AnWgelTGZOhQ2NV",
          "name": "Arm Spike.",
          "description": "Range 1 | No Damage.\nA Hit Target is pulled into The Lost's Area. A Hit Target has 1 limb Restrained, and the limb The Lost attacked with is also Restrained. A Target that has 3 or more limbs Restrained bcomes full-body Restrained. \n\nThe Lost has 5 arm spikes but may only Restrain 1 Creature at a time, and it cannot relase a Creature voluntarily.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "vTygkIRXuxa4q5xXfWRU",
          "name": "Embedding Embrace.",
          "description": "A Creature Restrained by The Lost takes 1 Dark Damage for each arm Restraining it and must make a Grit Check or become Terrified until the beginning of The Lost's next Turn.\n\nIf the Crature rolls a Special Success, The Lost is Shocked/Stalled for 1 Turn and releases any Creature Restrained by it.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "tzBBrRgV5RwndrkWfbXF",
          "name": "Disorienting Wail.",
          "description": "Creatures within 4 Areas of The Lost who can hear its constant wailing suffer a Snag on Grit, Insight, and Aura Checks.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "FaKLlH70vhmY5trSjAMq",
          "name": "Psychic Flood.",
          "description": "Once per Round, when The Lost takes Damage, it forces the Creature it's Restraining to make a Grit Check or suffer an equal amount of Dark Damage.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "3XW4enJOMcDIYaDC9oGI",
          "name": "Storm of Limbs.",
          "description": "On its Turn, The Lost can make one Arm Spike attack for each arm that is not Restrained. Maximum 5. It can also use Embedding Embrace once.",
          "value": 0,
          "counters": {},
          "modifiers": []
        }
      ],
