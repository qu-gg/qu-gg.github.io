          "id": "gVpdF6Zax1HbVoVpEzr4",
          "name": "Peep-Bot.",
          "description": "Whoever controls the Techatiel is instantly aware of anything it sees or hears. The owner can send it commands remotely and even speak through it. This Ability has a range of a few miles.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "6T9CPjsp5UIsJIyjfcgy",
          "name": "Droning Screech.",
          "description": "As an Action, the Techatiel can open its beak (revealing a speaker) and emit a reverberating drone. Affects all Areas within 1 Area of the Techatiel. Requires a Grit Check or become Deafened.",
          "value": 0,
          "counters": {},
          "modifiers": []
        }
      ],
