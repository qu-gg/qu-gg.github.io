        },
        {
          "id": "gLvVZFSw7ULjeVSiUo5G",
          "name": "Inferno of Fire and Steel.",
          "description": "Immune to Fire Damage.\nImmune to Attacks from items not made of Magical Materials.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "pwzv4H5hqFCSE4qn6drq",
          "name": "Hellfire Pummelstorm.",
          "description": "As an Action, the Solar Orb Sentinel can unleash a reckless barrage of fists. It immediately takes 4 Attack Actions at half its Attack Bonus. If it takes this Action, its Defense Rating is reduced by 2 until its next Turn.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "NqSHgz7szr2jcry74hXq",
          "name": "Not Your Average Fire Flower.",
          "description": "As an Action, the Solar Orb Sentinel can conjure a mighty Ball of fire and throw it up to 1 Area away. The Ball moves in a straight line 1 Area per Turn for 3 Turns. Upon entering an Area, all other Creatures within that Area must make a Deftness Check or be Toppled and take 2 Fire Damage. Any Area the Ball passes through becomes Harmful [Fire]. Only 1 Ball can be active at a time.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "WIXNNJKUZZQ1RL3FG82q",
          "name": "Going Out with a Bang.",
          "description": "On reaching 0 Hearts, the Solar Orb Sentinel starts to fall apart, arms clanking down. Cracks begin to show in the orb as it brightens. It functions as a Bomb, arming itself on the Turn it falls and going off on the next Turn.",
          "value": 0,
          "counters": {},
          "modifiers": []
        }
      ],
