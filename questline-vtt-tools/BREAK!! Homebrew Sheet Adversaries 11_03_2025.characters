          "details": [
            {
              "type": "description",
              "visibility": "full",
              "value": {
                "description": "Range: Melee\nDamage: 1\nThreshold: 22\n\n**Weapon Ability, Darting Style:**\nYou gain a +1 to your Defense Rating when using a Quick Weapon."
              }
            },
            {
              "type": "image",
              "value": {
                "image": {
                  "url": "https://firebasestorage.googleapis.com/v0/b/rpg-pbp.appspot.com/o/games%2Fn9qXCE2Ylwj8dBmy4lpo%2Fimages%2FmH4xR0mvLOFXabOaDFFw.png?alt=media&token=416262cb-30fa-4841-92e7-3bd42b233484",
                  "tokenCrop": {
