        "currency": {}
      },
      "attack-bonus": {
        "attributes": {
          "attack-bonus": {
            "value": {
              "visible": true,
              "value": 1
            }
          }
        }
      },
      "notes": [
        {
          "description": "Gargoyles, for better or worse, are ruthless hunters and guardians and will\r\nfulfill their duties by:\r\n- Focus on a single target that\u2019s drawn too close, reducing them to 0 Hearts and inflicting Injuries until they cannot get up again\r\n- Pursue their targets until either they or the Gargoyle is destroyed\r",
          "counterOverrides": {},
          "rollDetails": [],
          "id": "DBMa0akRFxeJjA4o7MVe",
          "type": "Quick Facts",
          "originId": "tactics",
          "counters": {},
          "modifiersPostCalculationFunc": null,
          "modifiers": [],
          "linkedValue": null,
          "name": "Tactics",
          "value": 0
        },
        {
          "counters": {},
          "counterOverrides": {},
          "type": "Quick Facts",
          "rollDetails": [],
          "linkedValue": null,
          "modifiersPostCalculationFunc": null,
          "description": "They can understand Low Speech and any other languages spoken by their creator or the one who gave them life, but they cannot speak themselves.\n",
          "name": "Communication",
          "modifiers": [],
          "value": 0,
          "id": "Ntrz5p3hvUCRqLHi17zk",
          "originId": "communication"
        },
        {
          "rollDetails": [],
          "id": "vhRuuxAZkiU0q109rpWa",
          "description": "If you wish to make the gargoyle more challenging and since it was brought to life through magical means, perhaps you could give it access to a few Magical Abilities.\r",
          "type": "Quick Facts",
          "counterOverrides": {},
          "name": "Customization",
          "modifiers": [],
          "value": 0,
          "modifiersPostCalculationFunc": null,
          "originId": "customization",
          "linkedValue": null,
          "counters": {}
        },
        {
          "rollDetails": [],
          "value": 0,
          "name": "Habitat",
          "description": "Most common around the walls and parapets of castles and churches.\r",
          "id": "cjG1nkOm4vkZPU7IEdlU",
          "originId": "habitat",
          "linkedValue": null,
          "type": "Quick Facts",
          "counterOverrides": {},
          "modifiers": [],
          "modifiersPostCalculationFunc": null,
          "counters": {}
        },
        {
          "counterOverrides": {},
          "description": "The soft grinding of stone on stone, the unsettling realization that a stone statue\u2019s head has moved.",
          "modifiersPostCalculationFunc": null,
          "name": "Indicators",
          "counters": {},
          "originId": "indicators",
          "type": "Quick Facts",
          "id": "OTg2GH2abw8CnphoYRBP",
          "linkedValue": null,
          "value": 0,
          "modifiers": [],
          "rollDetails": []
        },
        {
          "type": "Quick Facts",
          "value": 0,
          "linkedValue": null,
          "modifiersPostCalculationFunc": null,
          "counters": {},
          "description": "Gargoyles will not act until someone has gotten too close to the location they guard, whether it\u2019s by climbing, by ground, or by air. They are simple but deadly creations motivated by nothing else.\r",
          "name": "Role Playing Notes",
          "counterOverrides": {},
          "rollDetails": [],
          "originId": "role-playing-notes",
          "id": "v0qTdpe9Mn52Vnrvpjar",
          "modifiers": []
        }
      ]
