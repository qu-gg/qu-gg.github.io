      "abilities": [
        {
          "id": "M7uUVSsC5G1MkiP0n8y0",
          "name": "Sticky Tongue.",
          "description": "The Glowcroak's long, adhesive tongue can snare Creatures or objects from a distance. On a successful Hit, the Target is pulled into its Area, making it vulnerable to the Glowcroak's next Attack, giving it an Edge on the Attack.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "6ZeyAGj2V57EN8O8CIEs",
          "name": "Flash Pulse.",
          "description": "As an Action, the Glowcroak can emit a sudden burst of bright, blue light from its bioluminescent spots. All Creatures within the same Area must make an Insight Check or be Blinded for 1 Turn.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "WsOdjjxBdbXd4lEQZLsR",
          "name": "Amphibious.",
          "description": "The Glowcroak can move through water and swampy terrain without penalty, allowing it to easily traverse the wetlands of Glimmire Isle.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
