      "abilities": [
        {
          "id": "aCee4Pw5wwzjpCjqcXM6",
          "name": "Radiant Nectar.",
          "description": "A Spit can shoot a bolt of radiant nectar that functions as a Drawn Weapon and deals Bright Damage. This does not require any ammunition. \r\nAdds 1 Bright Allegiance.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "AoihopatJ1K4z0cXZ7HQ",
          "name": "Rooted.",
          "description": "A Spit is usually rooted to the ground. It takes an Action to root or unroot. While rooted the Spit cannot move. While rooted in soil and sunlight, the Spit may spend an Action drawing energy from the earth and sun to heal 1 Heart. This cannot be done again for 2 Turns after it is used or the Spit moves. \r\nAdds 1 Bright Allegiance.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
