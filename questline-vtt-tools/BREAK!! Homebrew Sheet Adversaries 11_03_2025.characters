          "rollDetails": []
        },
        {
          "type": "Quick Facts",
          "value": 0,
          "linkedValue": null,
          "modifiersPostCalculationFunc": null,
          "counters": {},
          "description": "Basically just a mindless rampaging beast. Roar, beat your chest, let the rage wash over you. For flavour, you can have Bellzuub show up (in-person or through magical means) and order it to leave, which it will obey abruptly. This is also a good option if the party cannot figure out the secret to bypassing Phantom Abomination and are at risk of being wiped out because of it.",
          "name": "Role Playing Notes",
          "counterOverrides": {},
