        },
        {
          "rollDetails": [],
          "value": 0,
          "name": "Habitat",
          "description": "Likely the top of some ancient spiritual location, meditating in wait for adventurers requiring specialized knowledge or riddles.",
          "id": "cjG1nkOm4vkZPU7IEdlU",
          "originId": "habitat",
          "linkedValue": null,
          "type": "Quick Facts",
          "counterOverrides": {},
          "modifiers": [],
