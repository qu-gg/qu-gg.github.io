      "attack-bonus": {
        "attributes": {
          "attack-bonus": {
            "value": {
              "visible": true,
              "value": 4
            }
          }
        }
      },
      "notes": [
        {
          "description": "Tower Dragons are more like a last line of defense towards any castles or such structures they protect, mean they will:\r\n- Attack enemies from above with its Lightning Breath.\r\n- Use Repulsion Breath to knock enemies off of high places for easy kills.\r\n- Support any gargoyles engaged in any prolonged combat.\r\n- Relentlessly hunt down any enemies until either they or it is destroyed.\r\n",
          "counterOverrides": {},
          "rollDetails": [],
          "id": "DBMa0akRFxeJjA4o7MVe",
          "type": "Quick Facts",
          "originId": "tactics",
          "counters": {},
          "modifiersPostCalculationFunc": null,
          "modifiers": [],
          "linkedValue": null,
          "name": "Tactics",
          "value": 0
        },
        {
          "counters": {},
          "counterOverrides": {},
          "type": "Quick Facts",
          "rollDetails": [],
          "linkedValue": null,
          "modifiersPostCalculationFunc": null,
          "description": "They can understand Low Speech and any other languages spoken by their creator or the one who gave them life, but they cannot speak themselves.\r\n",
          "name": "Communication",
          "modifiers": [],
          "value": 0,
          "id": "Ntrz5p3hvUCRqLHi17zk",
          "originId": "communication"
        },
        {
          "rollDetails": [],
          "id": "vhRuuxAZkiU0q109rpWa",
          "description": "Swap out the Tower Dragons Lightning and Repulsion Breath.\r\n",
          "type": "Quick Facts",
          "counterOverrides": {},
          "name": "Customization",
          "modifiers": [],
          "value": 0,
          "modifiersPostCalculationFunc": null,
          "originId": "customization",
          "linkedValue": null,
          "counters": {}
        },
        {
          "rollDetails": [],
          "value": 0,
          "name": "Habitat",
          "description": "Along city walls and near castle towers.",
          "id": "cjG1nkOm4vkZPU7IEdlU",
          "originId": "habitat",
          "linkedValue": null,
          "type": "Quick Facts",
          "counterOverrides": {},
          "modifiers": [],
          "modifiersPostCalculationFunc": null,
          "counters": {}
        },
        {
          "counterOverrides": {},
          "description": "The soft grinding of stone on stone, the unsettling realization that a stone statue\u2019s head has moved",
          "modifiersPostCalculationFunc": null,
          "name": "Indicators",
          "counters": {},
          "originId": "indicators",
          "type": "Quick Facts",
          "id": "OTg2GH2abw8CnphoYRBP",
          "linkedValue": null,
          "value": 0,
          "modifiers": [],
          "rollDetails": []
        },
        {
          "type": "Quick Facts",
          "value": 0,
          "linkedValue": null,
          "modifiersPostCalculationFunc": null,
          "counters": {},
          "description": "Tower Dragons will not act until someone has gotten too close to the location they guard, whether it\u2019s by climbing, by ground, or by air. They are simple but deadly creations motivated by nothing else.\r\n",
          "name": "Role Playing Notes",
          "counterOverrides": {},
          "rollDetails": [],
          "originId": "role-playing-notes",
          "id": "v0qTdpe9Mn52Vnrvpjar",
          "modifiers": []
        },
        {
          "value": 0,
          "name": "Yield",
          "rollDetails": [],
          "counters": {},
          "modifiers": [],
          "type": "Loot",
          "description": "Element Gem (Lightning)\nAttack: Imbued weapons inflict Lightning damage.\r\nDefense: Imbued items reduce incoming Lightning Damage by 1.\r\nGlamor: Imbued items provide you with a thematic boost to your appearance that grant a Minor Bonus (+2) to Aura rolls.\r\n50 Coins per Unit",
          "modifiersPostCalculationFunc": null,
