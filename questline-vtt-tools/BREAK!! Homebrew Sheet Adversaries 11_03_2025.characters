        {
          "id": "q0ZGoUB42ucN2Se9q7Tq",
          "name": "Tortured Embrace.",
          "description": "Using Vein, on Hit, inflicts Stage 1 Petrify on the Target and the Vein is Restrained. Held Target cannot take any Actions that damage or contribute to Damage against The Heartbroken, and takes 1 Dark Damage at the end of each of its Turn. \n\nCan only hold 1 Target at a time.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "VJZUEOSbqKhFIlHIc7WR",
          "name": "Deathly Kiss.",
          "description": "As an Action, The Heartbroken can Attack a Target held via Tortured Embrace. On Hit, the Target takes 4 Dark Damage.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "9HrzI0GsCvBfZPsVhPUl",
          "name": "Bitterness.",
          "description": "If The Heartbroken is subjected to a Spell or Ailment, it may apply that Spell or Ailment to the aggressor as if The Heartbroken had cast it.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "smQfdOnrUZU2Ukv2XB6I",
          "name": "Heartache.",
          "description": "The Heartbroken suffers a Snag on Attacks against Creatures that have touched it or hit it with a melee weapon since the end of its last Turn, but makes Attacks with an Edge against all other Creatures.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "A7ZSLWGvhqPA1fzPFSuL",
          "name": "Magic Resistance.",
          "description": "The Heartbroken has an Edge on all Checks made to resist Magical Effects.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "rOprbe0arWDCDQzk79Ho",
          "name": "Multiattack.",
          "description": "The Heartbroken can make 2 Vein Attacks, and can replace one of them with Tortured Embrace.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "g5IawVZYauK7Zj6ipKUa",
          "name": "New Life.",
          "description": "Whenever The Heartbroken deals an Injury that would kill, it instead disappears and possesses the body which regains all Hearts.\n\nWhile possessing a body, The Heartbroken is untargetable and gains the Target's statistics. It does not gain the Target's knowledge or Calling Features. Posession lasts until the body falls to 0 Hearts. The Heartbroken reappears in the same Area as the body, and the body is Toppled and takes no Injury.",
          "value": 0,
          "counters": {},
          "modifiers": []
        }
      ],
