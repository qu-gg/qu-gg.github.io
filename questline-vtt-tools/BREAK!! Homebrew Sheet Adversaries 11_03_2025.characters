            }
          }
        }
      },
      "aptitudes": {
        "attributes": {
          "aptitudes": {
            "insight": {
              "visible": true,
              "value": 11
            },
            "grit": {
              "visible": true,
              "value": 6
            },
            "aura": {
              "value": 7,
              "visible": true
            },
            "might": {
              "value": 3,
              "visible": true
            },
            "deftness": {
              "value": 5,
              "visible": true
