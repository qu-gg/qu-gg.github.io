      "bio": {
        "background": "Created by: Skig",
        "size": "Medium",
        "name": "Spit",
        "subname": "Rank 1 Boss",
        "tokenCrop": "",
        "details": "A spit is a plant infused with bright energy. Various types of plants can become infused and turn into spits, but they are usually tall flowering plants. When they become Spits the flowers develop a primary steam and flowerhead that grows into a faintly head like shape, while they also form a woody stub body like that of a Bristle but four legged with the main stem forming a neck. Spits have ungainly bodies and mostly stay stationary, looking very much like normal plants with on large animate stem.  Spits have a strongly citrus aroma.",
        "appearance": "",
        "characteristics": {
          "height": "",
          "skin": "",
          "weight": "",
          "age": "",
          "eyes": "",
          "hair": "",
          "gender": ""
        },
        "profileImage": null
      },
