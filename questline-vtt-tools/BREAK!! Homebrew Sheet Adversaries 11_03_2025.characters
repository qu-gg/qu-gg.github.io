      "abilities": [
        {
          "id": "uXlgjp2Te5IXDSFdXyR9",
          "name": "Vicious Strike.",
          "description": "As an Action, The Fearful can Attack a Terrified Target, dealing 3 Damage on a Hit.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "2K5iOf8YowHN4n6QkPxo",
          "name": "Frightful Gaze.",
          "description": "As an Action, it can Target all Creatures that it is terrified of that can see it, forcing them to make a Grit Check.\n- Success: 1 Damage.\n- Failure: 3 Damage and become Terrified of The Fearful.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "eWjyTliAcFyOHWbIjljm",
          "name": "Lamenting Scream.",
          "description": "As an Action, it can Target all Creatures terrified of it of that can hear it, forcing them to make a Grit Check, inflicting Fright Cursed Ailment on Failure.\n\nFright Cursed Ailment: Creature's Speed is reduced to Slow, it suffers a Snag on Grit Checks/Contests, and it takes 1 Damage at the start of each of its Turns until cured.\n\nCannot be used 2 Turns in a row.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "LuFSSSX22NumQQAsUq2C",
          "name": "Eyes of Panic.",
          "description": "The Fearful can see in all directions, and has an Edge on Checks or Contests that rely on sight. In addition, it can see invisible creatures and objects up to 5 Areas away.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "tBFWC6Lma8TRpIweHIlS",
          "name": "Fear Aura.",
          "description": "Any Creature hostile to The Fearful that starts its Turn within 2 Areas of The Fearful must make a Grit Check, unless The Fearful is incapacitated.\n- Failure: The Creature is Terrified.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "1dfwqyKRZ6jSIh5pDApS",
          "name": "Fearful.",
          "description": "The Fearful is Terrified of Creatures that it can see within 2 Areas of it that aren't Sorrowsworn or Terrified of it. If The Fearful is Terrified of at least 1 Creature that it can see at the start of its Turn, it regains 2 Hearts and Attacks against it suffer a Snag.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "lrmJhJWuNFnjmoeBLOkP",
          "name": "Tyrant.",
          "description": "The Fearful gains an Edge on Attack rolls against Terrified Creatures.",
          "value": 0,
          "counters": {},
          "modifiers": []
        }
      ],
