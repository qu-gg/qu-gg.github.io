      "bio": {
        "background": "Created by: Atyai",
        "size": "Small",
        "name": "Lurki-slime",
        "subname": "Rank 4 Boss",
        "tokenCrop": "",
        "details": "A distant cousin of Lumi-slimes, Lurki-slimes are typically found inside of empty chests or crates. These carnivorous slimes prey on both weary travelers and greedy treasure hunters alike.",
        "appearance": "",
        "characteristics": {
          "height": "",
          "skin": "",
          "weight": "",
