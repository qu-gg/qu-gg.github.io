      "abilities": [
        {
          "id": "2WuwL891wwxfgEvHZqiQ",
          "name": "Fetus of Divinity [A].",
          "description": "The Atropal is Massive.\nFocus Attack: Half formed hands strike as Mighty Weapons that do Dark Damage.\nSweep Attack: Umbilical cord strikes as a Lash Weapon that does Dark Damage.\n\nBright Damage deals an extra Heart of Damage. Dark Damage heals Hearts equal to any damage inflicted. Immune to Frost Damage and any damage from nonmagical weapons.\n\nImmune to Putrified, Fatigue, Terrified, and Topple. The Atropal can see within darkness.\n\nIt hovers instead of walks due to its useless, half formed legs.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "VgCfYyoP2wREBD5HmTTJ",
          "name": "Negative Energy Aura [A][M].",
          "description": "Creatures within the same Area as the Atropal can\u2019t regain Hearts and take 1 Dark Damage upon starting their Turn within the Area.\n\nIf struck by a magic weapon that cuts, the wielder can choose to sever the Atropal\u2019s umbilical cord instead of doing damage. If the cord is cut, it loses this feature.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "H6Y7FksKTY6jNN0Wr1t0",
          "name": "Magic Resistance [A].",
          "description": "The Atropal has an Edge on all Checks against Magical Abilities and Effects.\n\nRay of Cold [B][M].\nThe Atropal fires a ray of ice mana up to 3 Areas that does 2 Frost Damage.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "yVDYphMEvVOW3wVkKzLr",
          "name": "Life Drain [L][M].",
          "description": "The Atropal chooses 1Target within 2  Areas. \n\nThe Target must make a Grit Check: \n- Success, no damage is taken.\n- Failure: Take 2 Dark Damage and the Atropal is healed for the amount of damage inflicted.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "brTI5ZmuUengVhi2eYYF",
          "name": "Summon Undead [L][M].",
          "description": "The Atropal summons an undead equal in strength to a Skelemaster, which materializes within the same Area as it. The undead obeys the commands of the Atropal and can\u2019t be controlled by anyone else.\nThe undead vanishes upon reaching 0 Hearts or the Atropal is destroyed.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "csu5ABUdxifwc9ElqRZJ",
          "name": "Wail [L][M].",
          "description": "The Atropal lets out a withering wail.\nAny Creature within 3 Areas that can hear must make a Grit Check or gain 1 level of Fatigue.",
          "value": 0,
          "counters": {},
          "modifiers": []
        }
      ],
