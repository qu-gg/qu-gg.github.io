        "currency": {}
      },
      "attack-bonus": {
        "attributes": {
          "attack-bonus": {
            "value": {
              "visible": true,
              "value": 3
            }
          }
        }
      },
      "notes": [
        {
          "description": "Lurki-slimes will only attack if they think they have the element of surprise. If they are spotted before engaging, they will attempt to get away and hide before continuing to single-mindedly stalk their prey.\r",
          "counterOverrides": {},
          "rollDetails": [],
          "id": "DBMa0akRFxeJjA4o7MVe",
          "type": "Quick Facts",
          "originId": "tactics",
          "counters": {},
          "modifiersPostCalculationFunc": null,
          "modifiers": [],
          "linkedValue": null,
          "name": "Tactics",
          "value": 0
        },
        {
          "value": 0,
          "modifiersPostCalculationFunc": null,
          "name": "Combat Gear",
          "id": "AdV2VUGGxlLp3oS0OFPO",
          "counterOverrides": {},
          "linkedValue": null,
          "counters": {},
          "rollDetails": [],
          "description": "They do not possess or make use of conventional weapons or armor.\r\n",
          "type": "Quick Facts",
          "originId": "combat-gear",
          "modifiers": []
        },
        {
          "counters": {},
          "counterOverrides": {},
          "type": "Quick Facts",
          "rollDetails": [],
          "linkedValue": null,
          "modifiersPostCalculationFunc": null,
          "description": "Many species of slime or goop can use a crude body language emulating larger vertebrate, though few of them are intelligent enough to do so beyond simple displays of aggression.\r\n",
          "name": "Communication",
          "modifiers": [],
          "value": 0,
          "id": "Ntrz5p3hvUCRqLHi17zk",
          "originId": "communication"
        },
        {
          "rollDetails": [],
          "id": "vhRuuxAZkiU0q109rpWa",
          "description": "A less common species in the same genus, Lookalikes can convincingly replicate the shape of a stationary object and even recolor their surface to match. This ability stands in for Patient Predator with the same effect.\r\n",
          "type": "Quick Facts",
          "counterOverrides": {},
          "name": "Customization",
          "modifiers": [],
          "value": 0,
          "modifiersPostCalculationFunc": null,
          "originId": "customization",
          "linkedValue": null,
          "counters": {}
        },
        {
          "rollDetails": [],
          "value": 0,
          "name": "Habitat",
          "description": "Lurki-slimes prefer a cool, dark, and wet places. They often leave trails of moist brackish film with a faintly astringent odor on cavern walls to mark their passage to other slimes. Bone fragments with irregular pitting can be found discarded haphazardly outside their dens.\n",
          "id": "cjG1nkOm4vkZPU7IEdlU",
          "originId": "habitat",
          "linkedValue": null,
          "type": "Quick Facts",
          "counterOverrides": {},
          "modifiers": [],
          "modifiersPostCalculationFunc": null,
          "counters": {}
        },
        {
          "type": "Quick Facts",
          "value": 0,
          "linkedValue": null,
          "modifiersPostCalculationFunc": null,
          "counters": {},
          "description": "Lurki-slimes only know hunt and hunger. If you find one nearby, they are likely already hunting you.\r\n",
          "name": "Role Playing Notes",
          "counterOverrides": {},
          "rollDetails": [],
          "originId": "role-playing-notes",
          "id": "v0qTdpe9Mn52Vnrvpjar",
          "modifiers": []
        },
        {
          "value": 0,
          "name": "Yield",
          "rollDetails": [],
          "counters": {},
          "modifiers": [],
          "type": "Loot",
          "description": "Sharpened Bones. Can be used as a Shoddy Concealed Weapon. Suspended in the gelatinous body of the creature may be a small number (1d20) of coins taken from their hiding place or their last meal.",
          "modifiersPostCalculationFunc": null,
          "id": "RGRabawcHH0Dfexa8slm"
        }
      ]
