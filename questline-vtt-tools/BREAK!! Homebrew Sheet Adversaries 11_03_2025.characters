      "abilities": [
        {
          "id": "tv1Ugd2OHbHoNaKt3GAs",
          "name": "Squeaking Mass.",
          "description": "Rather than a single entity, Bedmunks swarm in the dozens.\r\nBedmunks follow the Bizzer Swam's Buzzing Mass Ability with the exception that they cannot fly.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "mYiRhJmbXbehQK7spLuX",
          "name": "Sic 'Em.",
          "description": "Engulfing a foe requires the Bedmunk Swarm to use its Action, but does not require an Attack roll.\r\nEngulf can be used on a single creature or object in the same Area as the swarm.\r\nAnyone attacking the Swarm while it is using this Ability will hit the swarm\u2019s target instead on an unsuccessful attempt.\r\nA Target that is engulfed is both Blinded and Deafened. If Engulfed at the start of their Turn, they take 1 Damage.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "SA7hIgfdMWLiLYw1pZML",
          "name": "Self-Preservation.",
          "description": "Bedmunks will not fight to the death. If any of their ally Swarms perish, they will all attempt to Flee.",
          "value": 0,
          "counters": {},
          "modifiers": []
        }
      ],
