      "abilities": [
        {
          "id": "zlmAe7YTVqwb2iW3zcbl",
          "name": "Why Are You Hitting Yourself?.",
          "description": "Echoes are basic manifestations of Dark magic which have no mind to think for themselves, so they can only react. When attacked, the Echo can return the Attack on their next Turn with the same Weapon and Attack Bonus the Attacker used.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "gHwwAuuM6c7zhIROM3WI",
          "name": "Unreal.",
          "description": "Their Speed Rating is Slow. It can be hard to keep track of an Echo's shifting form, increasing their Defense Rating by 2. Echoes are weak to Bright damage and suffer +1 Damage from each Attack.",
          "value": 0,
          "counters": {},
          "modifiers": []
        }
      ],
