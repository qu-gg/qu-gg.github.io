      "actions": [
        {
          "version": 2,
          "id": "XD62qXhjPAQ5QmzuEsnX",
          "displayName": "Kabocha Claws",
          "effects": [
            {
              "type": "roll",
              "name": "",
              "quantity": 1,
              "hide": false,
              "bonusRoll": "",
              "encounterRoll": false,
              "modifiers": [
                {
