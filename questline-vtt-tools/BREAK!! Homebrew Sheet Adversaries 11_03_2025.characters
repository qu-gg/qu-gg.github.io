      "bio": {
        "background": "Created by: ichiCharmed [Discord]",
        "size": "Massive",
        "name": "Drakkenheim \nSewer Gator",
        "subname": "Rank 6 Mega-Boss",
        "tokenCrop": "",
        "details": "Giant gator, gray and gnarled. A reptilian beast that was already great in size, now massive and mutated by forces and methods one can only dream about. Its growls that can be heard from sewers are the only indication one truly exists, for anyone who has gone to investigate has never returned.",
        "appearance": "Movement types: Land, Water",
