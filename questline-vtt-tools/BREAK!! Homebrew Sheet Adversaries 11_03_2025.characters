      "actions": [],
      "abilities": [
        {
          "id": "n9Ak7bVfQPEkGOMh1YKe",
          "name": "Harpoon Arms.",
          "description": "Range: 2\nExtra Damage: 20\n\nA hit Target gains Stage 1 of the Petrified Ailment, and The Lonely's attacking limb is Restrained.\n\nDual Wielding: Can substitute Sorrowful Embrace for one or both Attacks.\n\nThese Arms can be attacked. DF 16, Hearts 2. Destroying an Arm deals no Damage to The Lonely, which can grow a replacement on its next Turn.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "0yCsnpca1TQOLiG0YNag",
          "name": "Sorrowful Embrace.",
          "description": "Creatures Petrified by The Lonely take 1 Dark Damage and are pulled 1 Area towards it.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "mdmgewvF5mKFWqxayF0P",
          "name": "Branching Barbs.",
          "description": "The Lonely causes its Harpoon Arms to grow branching barbs of jagged bone.\n\nEach Creature Petrified by it must make a Grit Check.\n- Failure: 4 Dark Damage\n- Success: 2 Dark Damage\n\nCannot be used 2 Turns in a row.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "TcwxTugODlCkXCxBM29w",
          "name": "Psychic Leech.",
          "description": "At the start of each of its Turns, each Creature in the same Area must make a Grit Check or take 1 Dark Damage.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "9PER4jmZXkNdbPJvWuhO",
          "name": "Thrives on Company.",
          "description": "The Lonely gets an Edge on Attack rolls while within 2 Areas of at least 2 other Creatures.\n\nThe first time each Turn that a Creature leaves this range, The Lonely takes 1 Dark Damage.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "VxNFvDtwbnLV1V35QTq4",
          "name": "Wretched Sobbing.",
          "description": "Once per Round, when a Creature leaves its reach (2 Areas), The Lonely lets out a wretched sob. \n\nEach Creature within 3 Areas that can hear it must make a Grit Check or be unable to move away from The Lonely until the beginning of their next Turn.",
          "value": 0,
          "counters": {},
          "modifiers": []
        }
      ],
