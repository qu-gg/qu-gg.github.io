      "inventory": {
        "maxEncumbrance": 0,
        "items": [
          {
            "id": "AwgiBRFHKOLA7AkDTbO2",
            "itemId": "LZb3T7N8w4kG5awFR0yw",
            "name": "Stone Eyes",
            "description": "With the right Ability, a Gargoyle\u2019s eyes can be extracted from the construct\u2019s remains, allowing one with magical capabilities and a successful Insight Check to also see through the eyes of any nearby enchanted Gargoyles.",
            "type": "none",
            "privacy": {
              "level": "public",
              "users": []
            },
            "creator": "",
            "data": {
              "cost": {
                "coins": 15
