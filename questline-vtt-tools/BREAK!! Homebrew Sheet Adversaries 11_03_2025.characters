      "bio": {
        "background": "Created by: ichiCharmed [Discord]",
        "size": "Medium",
        "name": "Synthister",
        "subname": "Rank 4 Boss",
        "tokenCrop": "",
        "details": "Artificial vampires powered by desire. Dimensional Stray humans infesting Stray City that mimic the strength and agility of typical vampires, but minus the unfortunate thirst for blood.",
        "appearance": "",
        "characteristics": {
          "height": "",
          "skin": "",
          "weight": "",
