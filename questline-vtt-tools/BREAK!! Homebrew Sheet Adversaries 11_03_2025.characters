          "originId": "communication"
        },
        {
          "rollDetails": [],
          "id": "vhRuuxAZkiU0q109rpWa",
          "description": "Some of these elder cats have been known to cure serious wounds when laid beneath them, their deep rumbling purrs having healing effects similar to old magic.",
          "type": "Quick Facts",
          "counterOverrides": {},
          "name": "Customization",
          "modifiers": [],
