      "abilities": [
        {
          "id": "r7fZxDUYhNp9pO2kKWug",
          "name": "Rock, Paper, Freeze!",
          "description": "As an Action, the Ya-te-veo can open its head-fist and flare its eye with petrifying light.\n- Requires a Grit Check or become Petrified to a gorgeous multi-colored marble (16 Defense Rating, 6 Hearts).\n- This Ability can only be attempted on a given Target once during a Fight, including across multiple Ya-te-veos.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "AL4SsmkZnBhy24htwUc6",
          "name": "The Joy of Sundering.",
          "description": "If the Ya-te-veo petrifies a Target successfully, it will do everything in its power to shatter the statue.\n- As an Action, it can automatically hit the statue, dealing 2 Damage.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "1Yj09MvQvrObBjRra2JT",
          "name": "Heavy Handed.",
          "description": "The Ya-te-veo has Supernatural Strength.\nAs an Action, the Ya-te-veo can throw a Creature up to 2 Areas away at a Target. On a hit Attack, both the Creature and Target take 1 Damage and are Toppled. On a miss, the thrown Creature lands 2 Areas away and is Toppled. Picking up another Creature happens automatically unless they have Supernatural Strength, which then becomes a Might Contest.",
          "value": 0,
          "counters": {},
          "modifiers": []
        }
      ],
