              "value": 10
            }
          }
        }
      },
      "inventory": {
        "maxEncumbrance": 0,
        "items": [
          {
            "id": "DTeG2pR9dp8Cb2RsCAWZ",
            "itemId": "x8z64r5qCZRJzDVt1P9R",
            "name": "Spit yield 4 Bright Dew",
            "description": "Bright Dew.\n10 of these can be mixed together over the course of 1 minute to create a Bright Dew Potion.",
            "type": "none",
            "privacy": {
              "level": "public",
              "users": []
            },
            "creator": "",
            "data": {
              "cost": {
                "coins": 1
              },
              "encumbrance": 10.0
            },
            "version": 0,
            "owners": [],
            "quantity": 1,
            "equipped": false,
            "isCustom": true,
            "actions": []
          }
        ],
        "currency": {}
      },
      "attack-bonus": {
        "attributes": {
          "attack-bonus": {
            "value": {
              "visible": true,
              "value": 1
            }
          }
        }
      },
      "notes": [
        {
          "description": "A Spit likes to take and hold elevated positions. They will find a spot and claim it then defend it until they eventually run out of steam and turn back into a normal plant. Spits will hold their position and fire at any foe who approaches. If they have Bristle allies they will have them stay close and shield them, until the Spit takes a serious hit, at which point they will set the Bristles loose to charge.\nIn practice, Bristles will use defend actions to guard the Spit, until the spit takes damage at which point they will revert to their usually unchecked aggression.",
          "counterOverrides": {},
          "rollDetails": [],
          "id": "DBMa0akRFxeJjA4o7MVe",
          "type": "Quick Facts",
          "originId": "tactics",
          "counters": {},
          "modifiersPostCalculationFunc": null,
          "modifiers": [],
          "linkedValue": null,
          "name": "Tactics",
          "value": 0
        },
        {
          "counters": {},
          "counterOverrides": {},
          "type": "Quick Facts",
          "rollDetails": [],
          "linkedValue": null,
          "modifiersPostCalculationFunc": null,
          "description": "Speaks Low Speech and Bright Speech. Limited intellect means it will only ever issue warnings and shout insults.",
          "name": "Communication",
          "modifiers": [],
          "value": 0,
          "id": "Ntrz5p3hvUCRqLHi17zk",
          "originId": "communication"
        },
        {
          "rollDetails": [],
          "id": "vhRuuxAZkiU0q109rpWa",
          "description": "A dark, or even a twilight, version of spit could exist. They would need different damage types and a change to their behaviour to suit their alignment.",
          "type": "Quick Facts",
          "counterOverrides": {},
          "name": "Customization",
          "modifiers": [],
          "value": 0,
          "modifiersPostCalculationFunc": null,
          "originId": "customization",
          "linkedValue": null,
          "counters": {}
        },
        {
          "rollDetails": [],
          "value": 0,
          "name": "Habitat",
          "description": "Spit are a rarer variant of the same phenomena as Bristle. They can be found anywhere where the sun machine shines bright and vegetation is plentiful. Spits find spots with good light and visibility and set up a position to defend.",
          "id": "cjG1nkOm4vkZPU7IEdlU",
          "originId": "habitat",
          "linkedValue": null,
          "type": "Quick Facts",
          "counterOverrides": {},
          "modifiers": [],
          "modifiersPostCalculationFunc": null,
          "counters": {}
        },
        {
          "type": "Quick Facts",
          "value": 0,
          "linkedValue": null,
          "modifiersPostCalculationFunc": null,
          "counters": {},
          "description": "Spit don't really have thoughts or intelligence. They have a rudimentary mind made up of loose bright energy. They enjoy watching the open landscape and feel a potent drive to protect it from anything that moves. They can speak but don\u2019t do so in a coherent way, they cannot converse. They usually speak only to insult foes.",
          "name": "Role Playing Notes",
          "counterOverrides": {},
          "rollDetails": [],
          "originId": "role-playing-notes",
          "id": "v0qTdpe9Mn52Vnrvpjar",
          "modifiers": []
        }
      ]
    },
    "id": "Zcpv5C53H4xsQC74zxHC"
