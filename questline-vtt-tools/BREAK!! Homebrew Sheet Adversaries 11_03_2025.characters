      "bio": {
        "background": "Created by: KeJoRo [Discord]",
        "size": "Medium",
        "name": "Glocktopus",
        "subname": "Rank 5 Mega-Boss",
        "tokenCrop": "",
        "details": "Eight-armed sharpshooter. In the dark stillness of the various underground lakes that dot the Buried Kingdom lurk terrors of the deep known as the Glocktopus. Those unfortunate enough to encounter them often hear the thunderous crack of their curious biological firearms piercing the silence before being pierced themselves by the attack. Solitary predators by nature, it's rare to encounter more than one at a time. Sadly, the emphasis should be put on the word rare, and it should be noted that encounters of two or even more of these beasts have been documented.",
        "appearance": "Movement types: Land, Water",
        "characteristics": {
          "height": "",
          "skin": "",
          "weight": "",
          "age": "",
          "eyes": "",
          "hair": "",
          "gender": ""
        },
        "profileImage": null
      },
      "defense-rating": {
        "attributes": {
          "defense-rating": {
            "value": {
              "visible": true,
              "value": 12
            }
          }
        }
      },
      "inventory": {
        "maxEncumbrance": 0,
        "items": [
          {
            "id": "WfGs3bkUkuDUeAcdO6o3",
            "itemId": "XUstoCUBTsh7K7Vw20JR",
            "name": "Glocktoshot",
            "description": "Anyone willing to cut open and rake around inside a dead Glocktopus can find the strange biological ammunition they use to hunt their prey. Roll 1d20 to determine how many are found.\nThey may be used as bullets in a Mechanical Missile Weapon. They have no special features, but may be sold to scholars for considerably more than you would be able to get for standard ammunition.",
            "type": "none",
            "privacy": {
              "level": "public",
              "users": []
            },
            "creator": "",
            "data": {
              "cost": {
                "coins": 5
              },
              "encumbrance": 10.0
            },
            "version": 0,
            "owners": [],
            "quantity": 1,
            "equipped": false,
            "isCustom": true,
            "actions": []
          },
          {
            "id": "I5JMqwyj9QH2fG77rjJq",
            "itemId": "oHTr6baUFsukxu0ox0Nn",
            "name": "Black Powder-spiced Calamari",
            "description": "3 Slots of Glocktopus meat can be removed with the proper Ability. This tasty meat may be used as a Magic Consumable.",
            "type": "none",
            "privacy": {
              "level": "public",
              "users": []
            },
            "creator": "",
            "data": {
              "cost": {
                "coins": 50
              },
              "encumbrance": 1.0
            },
            "version": 0,
            "owners": [],
