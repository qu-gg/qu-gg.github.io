        }
      ],
      "abilities": [
        {
          "id": "r0mkjLp9e9IQJs8zg1pi",
          "name": "Sticky Situation.",
          "description": "By hurriedly applying water to themselves, Peppermint Lalka can become quite adhesive.\nAs an Action, the Lalka can lunge at a Target in an attempt to stick to them. Requires a Deftness Contest. On a Success, the Lalka adheres to the Target. An affected Creature loses a Speed Rating for every 2 Lalka attached to them. The Lalka can be removed with a successful Might Check.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "zbJBNgmwoN3mEj8vb1Ko",
          "name": "Minty Detonation.",
