          "id": "iPkv8E28eWqzVa0DaZJj",
          "details": [
            {
              "value": {
                "description": "Range: Melee\nDamage: 1\nThreshold: None\n\nUnarmed strikes suffer a Snag on their Attack roll when directed at armed or armored enemies."
              },
              "visibility": "full",
              "type": "description"
            },
            {
              "value": {
                "image": {
                  "url": "https://firebasestorage.googleapis.com/v0/b/rpg-pbp.appspot.com/o/games%2Fn9qXCE2Ylwj8dBmy4lpo%2Fimages%2FQDpIWCak2RhwohCi3Si1.png?alt=media&token=96b4cd4b-4fe2-44cf-b0b8-36df39a01ff2",
                  "tokenCrop": {
