    "isActive": true,
    "name": "[0] Klikabrik",
    "version": 9,
    "image": {
      "tokenCrop": {
        "unit": "%",
        "aspect": 1,
        "x": 25,
        "y": 25,
        "width": 50,
        "height": 50
      },
