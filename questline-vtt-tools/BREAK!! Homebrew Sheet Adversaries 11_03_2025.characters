      "bio": {
        "background": "Created by: quagg [Discord]",
        "size": "Medium",
        "name": "Snowmad",
        "subname": "Rank 2 Boss",
        "tokenCrop": "",
        "details": "Joy turned foul. Occasionally spirits or ambient Mana will infuse itself with the time-honored festive tradition of the snowman. Most are good for a playful snowball fight, but some line their snowballs with ice.",
        "appearance": "",
        "characteristics": {
          "height": "",
