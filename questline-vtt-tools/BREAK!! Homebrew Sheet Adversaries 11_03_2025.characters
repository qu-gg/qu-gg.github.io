      "inventory": {
        "maxEncumbrance": 0,
        "items": [
          {
            "id": "daih1hUAweow1sRf7nIz",
            "itemId": "LWBYGatYpdDTPtEW4gu6",
            "name": "Stone Eyes",
            "description": "With the right Ability, a Tower Dragon's eyes can be extracted from the construct\u2019s remains, allowing one with magical capabilities and a successful Insight Check to also see through the eyes of any nearby enchanted gargoyles.",
            "type": "none",
            "privacy": {
              "level": "public",
              "users": []
