      },
      "inventory": {
        "maxEncumbrance": 0,
        "items": [
          {
            "id": "H62vKLEBCXuPKwQ2DvIc",
            "itemId": "P3IoVpWglc0IshdWRXcT",
            "name": "Pum King Seeds",
            "description": "Enterprising souls willing to carve deep into a fallen Pum King may find a cache of seeds, finding enough to fill 1-3 inventory slots, depending on the age of the monster. The seeds are just as delicious as its body, but the true prize in finding them is in keeping them to use as ingredients for magical meals.\nEldritch: Consuming something imbued with this will protect you from extreme weather for one day and will also reduce the damage you take from Fire or Frost attacks you receive that day by 1 Heart.",
            "type": "none",
            "privacy": {
              "level": "public",
              "users": []
            },
            "creator": "",
            "data": {
              "cost": {
                "coins": 50
              },
              "encumbrance": 1.0
            },
            "version": 0,
            "owners": [],
            "quantity": 1,
            "equipped": false,
            "isCustom": true,
            "actions": []
          }
        ],
        "currency": {}
      },
      "attack-bonus": {
        "attributes": {
          "attack-bonus": {
            "value": {
              "visible": true,
              "value": 5
            }
          }
        }
      },
      "notes": [
        {
          "description": "Full of rage and aggression, there isn't much to their tactics. They will first leap on top of the biggest group they can reach, then lash out with their vines or, if their prey is alone, their leaves and jaws. Sometimes, a Pum King will be accompanied by a group of Pum Kin who help it, seemingly just for laughs. While the Pum King will not outright attack them, it will not bother to check if it is going to land on them.",
          "counterOverrides": {},
          "rollDetails": [],
          "id": "DBMa0akRFxeJjA4o7MVe",
          "type": "Quick Facts",
          "originId": "tactics",
          "counters": {},
          "modifiersPostCalculationFunc": null,
          "modifiers": [],
          "linkedValue": null,
          "name": "Tactics",
          "value": 0
        },
        {
          "counters": {},
          "counterOverrides": {},
          "type": "Quick Facts",
          "rollDetails": [],
          "linkedValue": null,
          "modifiersPostCalculationFunc": null,
          "description": "Pum Kings are unable to speak. Some scholars theorise that they can understand Low Speech, but testing for this has gone poorly.",
          "name": "Communication",
          "modifiers": [],
          "value": 0,
          "id": "Ntrz5p3hvUCRqLHi17zk",
          "originId": "communication"
        },
        {
          "rollDetails": [],
          "id": "vhRuuxAZkiU0q109rpWa",
          "description": "Removing Soaring Squash and Crushing Calabaza and replacing them with a reskinned, non-magical, physical version of the Blaster Mage's Magic Shot and Big Magic Shot Abilities would give a turret-like variant of the Pum King, spitting bullet-like seeds at foes.\n\nA Pum King can be reskinned to be a living boulder or that enemy with the onomatopoeic name from that series about a jumping plumber without much effort.",
          "type": "Quick Facts",
          "counterOverrides": {},
          "name": "Customization",
          "modifiers": [],
          "value": 0,
          "modifiersPostCalculationFunc": null,
          "originId": "customization",
          "linkedValue": null,
          "counters": {}
        },
        {
          "rollDetails": [],
          "value": 0,
          "name": "Habitat",
          "description": "Found in similar locations to the Pum Kin, albeit in places big enough to sustain them. They usually like to lie in wait in large clearings surrounded by trees, slamming down on anyone unfortunate enough to wander in unawares.",
          "id": "cjG1nkOm4vkZPU7IEdlU",
          "originId": "habitat",
          "linkedValue": null,
          "type": "Quick Facts",
          "counterOverrides": {},
          "modifiers": [],
          "modifiersPostCalculationFunc": null,
          "counters": {}
        },
        {
          "counterOverrides": {},
          "description": "Pulverised bodies, oddly-spaced craters, a sweet fruity smell mixed with the smell of fresh blood.",
          "modifiersPostCalculationFunc": null,
          "name": "Indicators",
          "counters": {},
          "originId": "indicators",
          "type": "Quick Facts",
          "id": "OTg2GH2abw8CnphoYRBP",
          "linkedValue": null,
          "value": 0,
          "modifiers": [],
          "rollDetails": []
        },
        {
          "type": "Quick Facts",
          "value": 0,
          "linkedValue": null,
          "modifiersPostCalculationFunc": null,
          "counters": {},
          "description": "Bestial and fierce, they are more a force of nature than a creature.",
          "name": "Role Playing Notes",
          "counterOverrides": {},
          "rollDetails": [],
          "originId": "role-playing-notes",
          "id": "v0qTdpe9Mn52Vnrvpjar",
          "modifiers": []
        },
        {
          "value": 0,
          "name": "Yield",
          "rollDetails": [],
          "counters": {},
          "modifiers": [],
          "type": "Loot",
          "description": "Delicious Fruit.\nThe flesh of a Pum King is delicious, but spoils quickly. After defeating a Pum King, a PC may eat a day's worth of food from its body, but may not take any for later.",
          "modifiersPostCalculationFunc": null,
          "id": "RGRabawcHH0Dfexa8slm"
        }
      ]
