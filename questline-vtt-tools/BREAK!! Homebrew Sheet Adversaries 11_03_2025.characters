      "abilities": [
        {
          "id": "KBRoSyTWhkGXV996OCyE",
          "name": "Shade Step.",
          "description": "On Even Rounds,  the sorceress can instantly teleport to any shadow up to 1 Area away. After teleporting, she gains a Major Bonus to her next Attack.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "p5au7dMYmn0wiTF50lGr",
          "name": "Devour the Light.",
          "description": "On Odd Rounds,  the sorceress can extinguish all light in an Area, plunging it into complete darkness for 3 Turns, making the area Obscured. She can see perfectly in this magical darkness.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "qg9pjphbWwJL3334OvKb",
          "name": "Shadowflame Wave.",
          "description": "Once per Fight, the sorceress can unleash a wave of shadowy fire across the battlefield. All Creatures in the same Area must make a Deftness Check or Take 2 Fire Damage and be pushed back 1 Area.",
          "value": 0,
          "counters": {},
          "modifiers": []
        }
