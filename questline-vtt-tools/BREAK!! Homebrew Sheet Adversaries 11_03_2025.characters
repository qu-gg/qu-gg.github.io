      },
      "inventory": {
        "maxEncumbrance": 0,
        "items": [],
        "currency": {}
      },
      "attack-bonus": {
        "attributes": {
          "attack-bonus": {
            "value": {
              "visible": true,
              "value": 4
            }
          }
        }
      },
      "notes": [
        {
          "description": "When threatened or hungry for life energy, a Synthister will:\n- Overpower an enemy before draining their life energy.\n- Disengage if bribed with rare goods based on Dimensional Stray media.\n- Use their human appearance to ambush prey.\n- Utilize any makeshift weapons or cans of Hyper Drink on their person to get an edge.\n- Run away if their clothes have been destroyed via Sundering or removed while in dark areas out of embarrassment.\n",
          "counterOverrides": {},
          "rollDetails": [],
          "id": "DBMa0akRFxeJjA4o7MVe",
          "type": "Quick Facts",
          "originId": "tactics",
          "counters": {},
          "modifiersPostCalculationFunc": null,
          "modifiers": [],
          "linkedValue": null,
          "name": "Tactics",
          "value": 0
        },
        {
          "value": 0,
          "modifiersPostCalculationFunc": null,
          "name": "Combat Gear",
          "id": "AdV2VUGGxlLp3oS0OFPO",
          "counterOverrides": {},
          "linkedValue": null,
          "counters": {},
          "rollDetails": [],
          "description": "Functional Outfit and a makeshift weapon (baseball bat, bus stop sign, oven mitts, etc.), but not ranged weapons, for some reason.",
          "type": "Quick Facts",
          "originId": "combat-gear",
          "modifiers": []
        },
        {
          "counters": {},
          "counterOverrides": {},
          "type": "Quick Facts",
          "rollDetails": [],
          "linkedValue": null,
          "modifiersPostCalculationFunc": null,
          "description": "Still being Dimensional Strays, they speak Low Speech and Other Wording.",
          "name": "Communication",
          "modifiers": [],
          "value": 0,
          "id": "Ntrz5p3hvUCRqLHi17zk",
          "originId": "communication"
        },
        {
          "rollDetails": [],
          "id": "vhRuuxAZkiU0q109rpWa",
          "description": "A Synthister who is an especially determined fan of your typical battle anime/manga or magical girl anime/manga may have (somehow) acquired a Champion, Raider, Battle Princess, Murder Princess, or Sage ability. Maybe an Advanced Ability and Fast Speed if it\u2019s a more \u201cgeneral\u201d level Synthister.\n\nMaybe reskin the Synthister as a species of leech people with a self destructive ability to make themselves stronger plus an aversion to sunlight.",
          "type": "Quick Facts",
          "counterOverrides": {},
          "name": "Customization",
          "modifiers": [],
          "value": 0,
          "modifiersPostCalculationFunc": null,
          "originId": "customization",
          "linkedValue": null,
          "counters": {}
        },
        {
          "rollDetails": [],
          "value": 0,
          "name": "Habitat",
          "description": "On the hunt for rare nerd goods, they more often than not designate Stray City as their hunting ground.",
          "id": "cjG1nkOm4vkZPU7IEdlU",
          "originId": "habitat",
          "linkedValue": null,
          "type": "Quick Facts",
          "counterOverrides": {},
          "modifiers": [],
          "modifiersPostCalculationFunc": null,
          "counters": {}
        },
        {
          "counterOverrides": {},
          "description": "A group of Strays surrounding a single person or small group of people for some reason, a strange aura of light only picked by certain technology, a supernatural desire for material goods.",
          "modifiersPostCalculationFunc": null,
          "name": "Indicators",
          "counters": {},
          "originId": "indicators",
          "type": "Quick Facts",
          "id": "OTg2GH2abw8CnphoYRBP",
          "linkedValue": null,
          "value": 0,
          "modifiers": [],
          "rollDetails": []
        },
        {
          "type": "Quick Facts",
          "value": 0,
          "linkedValue": null,
          "modifiersPostCalculationFunc": null,
          "counters": {},
          "description": "About as obnoxious and materialistic, if not more so, than the average Dimensional Stray, if I\u2019m totally honest.",
          "name": "Role Playing Notes",
          "counterOverrides": {},
          "rollDetails": [],
          "originId": "role-playing-notes",
          "id": "v0qTdpe9Mn52Vnrvpjar",
          "modifiers": []
        },
        {
          "value": 0,
          "name": "Yield",
          "rollDetails": [],
          "counters": {},
          "modifiers": [],
          "type": "Loot",
          "description": "When defeated in battle through any means, a Synthister will leave behind their weapon, their clothes/armor, a can of Hyper Drink, and a d20 of Coins.",
          "modifiersPostCalculationFunc": null,
          "id": "RGRabawcHH0Dfexa8slm"
