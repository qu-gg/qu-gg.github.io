      "abilities": [
        {
          "id": "WT6nJllsVyqRryH4Sou8",
          "name": "Crystal Smack [B].",
          "description": "The Crystalline Dreg\u2019s claws strike like Standard Weapons.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "Z1lXbQeYp6CiyDCIKQKP",
          "name": "Refracted Beam [A].",
          "description": "The Crystalline Dreg fires a beam of light at a Target, forcing a Deftness Check. On Failure, the Target takes 2 Bright Damage and is Blinded. The Target can shake off the blindness with a successful Grit Check at the start of their Turn.\n\nIf this Attack deals a different Special Damage type due to Refract Elements, it has additional effects:\nFlame: The Target is Burning and takes an additional 1 Flame Damage at the start of each Turn. The Target can spend an Action to tend to the Burning, removing the effect.\nFrost: The Target has the Restrained Condition.\nLightning: The Target is Shocked/Stalled.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "q20xoASLAuHUG6WrOjbd",
          "name": "Refract Element [A].",
          "description": "If the Crystalline Dreg is hit by Flame, Frost, or Lightning Damage, the Crystalline\u2019s Refracted Beam gains additional effects, like changing to match the type of Damage, on top of the Dreg itself gaining a Reduction of 1 Damage to that type until the end of its next Turn.",
          "value": 0,
          "counters": {},
          "modifiers": []
        }
      ],
