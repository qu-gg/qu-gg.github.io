      "abilities": [
        {
          "id": "rmo8jEXjda7kIqkKa5h7",
          "name": "Claws.",
          "description": "A Hit Target is fully Restrained, as is the limb The Hungry is attacking with. While Restraining a Target, The Hungry can't attack other creatures with its claws.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "Ih59QXZTiEKH9NJJxkrc",
          "name": "Life Hunger.",
          "description": "If a Creature The Hungry can see regains Hearts, The Hungry gains an Edge on Attacks until the end of its next Turn. Unless The Hungry gains an Edge on Attacks,  The Hungry suffers a Snag on Attacks made against Creatures who have at least 1 Injury.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "QSz30nQAbRu1kQ74A6xf",
          "name": "Ruinous Consumption.",
          "description": "A Creature that starts its Turn Restrained by The Hungry must make a Grit Check.\nFailure: The Creature takes an Armor Crash (or Wounded if unarmored). If a Creature gains the Wounded Injury enough times to kill it, it is instead given the Out Cold Injury in place of the last Wounded Injury. The Hungry regains 1 Heart for each Injury it deals this way.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "tT6V7a3Hen297GTw6eBc",
          "name": "Swallow Whole.",
          "description": "As an Action, The Hungry begins to swallow a Creature that is Out Cold and Restrained. At the beginning of The Hungry's next Turn, the Target is swallowed and gains the Mortal Wound Injury. The Hungry regains 3 Hearts.\n\nThe Action is disrupted if The Hungry takes any Bright Damage, is Toppled, or the Creature it is swallowing regains Hearts.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "xqSJgjB26AxfGMlqrnPC",
          "name": "Wave of Exhaustion.",
          "description": "Once per Fight, when The Hungry is reuced to 8 Hearts, it forces all Creatures within 2 Areas to make a Grit Check.\nFailure: Toppled and unable to stand up on the first Turn they spend Toppled.",
          "value": 0,
          "counters": {},
          "modifiers": []
        }
      ],
