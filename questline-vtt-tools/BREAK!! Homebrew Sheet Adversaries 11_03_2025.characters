      "abilities": [
        {
          "id": "SLn7UXvdavekuEDCtORk",
          "name": "Literally a Chunk of Rock.",
          "description": "The Door Dasher is a large hunk of stone, castle wall, and an ornate metal door. It has a natural Defense Rating of 20 and can only be damaged by items made of Magical Materials.\r\nAbilities that affect Sundering Objects apply to this Adversary.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "1tcWg4DIw7uJvV1Jm159",
          "name": "Leave Me Alone!",
          "description": "The Door Dasher is Very Fast and will always use its Action to try and Flee.\nIt has an Edge on resisting Magical Abilities.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "ywVYNAivcw39Kksex425",
          "name": "The Anywhere Aperture.",
          "description": "Opening the door of the Door Dasher requires a Deftness Contest if the Door Dasher can freely move.\nSuccessfully opening the door opens a gateway to another location across any distance or world. The location at the end of the door is left to either the GM or Players specification.",
          "value": 0,
          "counters": {},
          "modifiers": []
        }
      ],
