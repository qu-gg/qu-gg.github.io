      "abilities": [
        {
          "id": "glfediq6g9iaY5xeMxXG",
          "name": "Sealed Core.",
          "description": "When the Hexalith drops to half its Hearts, the Obsidian Hexalith can close its shards around its core, sealing it within and increasing its Defense Rating by +4 for the next two Turns. While sealed, it cannot use its Arcane Blast or Arcane Burst attack, but it becomes nearly impervious to most forms of damage.\r\nEffect: Once the core is sealed, all incoming Damage is reduced by 1, and the Hexalith is immune to critical hits. The Hexalith can still move and use its Shard Barrage attack while sealed.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "eFDz65sbBssyAzRsHoTW",
          "name": "Arcane Burst.",
          "description": "The Hexalith can channel its magical energy into a powerful burst, affecting all enemies within 1 Area of the Hexalith. This attack deals 2 Dark Damage and forces all affected Creatures to make an Insight Check or be Toppled.\r\nRecharge: This ability recharges on a 5 or 6 on a d6 at the start of each turn.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "2pqlsvs1PLJ7zG5yK7RL",
          "name": "Hexalithal Pulse.",
          "description": "The Hexalith can release a pulse of dark energy from its core, disrupting magical effects and damaging enemies. This pulse targets all Creatures within the same Area, dealing 2 Dark Damage and dispelling one magical effect in the Area.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "nfOGY0h6ptDUHzIQuzpg",
          "name": "Phase Shift.",
          "description": "Once per encounter, the Hexalith can phase out of the material plane for 1 Turn, becoming immune to all Damage and effects. It reappears at the start of its next Turn, at a location of its choosing within 2 Areas from where it disappeared.",
          "value": 0,
          "counters": {},
          "modifiers": []
        }
      ],
