          "name": "Self Repair.",
          "description": "Truck Kun will rebuild himself after 3 rounds unless his Fuzzy Dice have been stolen/scavenged.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "rFXX2oZsoxi4ZjDcDxit",
          "name": "Dimensional Rift.",
          "description": "Roll Aura to create a dimensional portal within 1 Area of Truck Kun. Another portal will appear wherever Truck Kun wants (use for maximum amusement). The portals remain for 3 Turns after summoning (so a party can follow Truck Kun if they are brave enough).",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "ngXDr2EapDbIjHaSlpzR",
          "name": "We Like to Party. By blasting its sound system, Truck Kun can summon nearby Mooks to harass the party, whatever monsters are around apparently do like to party!",
          "description": "This requires a Grit Check.",
          "value": 0,
          "counters": {},
          "modifiers": []
