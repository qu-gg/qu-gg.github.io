          {
            "id": "6epxnHBlmiWjWYIGPzu6",
            "itemId": "0ninOCYIOxyFbGvi5FWt",
            "name": "Boney Plate",
            "description": "3 Slots of boney plates can be removed with the right ability. This tough, heavy material can be used to make Heavy or Superheavy Armour and grants the Crafter a Minor Bonus on their Crafting Check.",
            "type": "none",
            "privacy": {
