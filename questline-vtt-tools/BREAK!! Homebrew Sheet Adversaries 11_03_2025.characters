      "abilities": [
        {
          "id": "s4IAJD5ryJxUthMlHCNK",
          "name": "Hook Hands.",
          "description": "Mighty Weapon. \nDual-Wielding\n\nA Hit Target is launched into an adjacent Area.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "6cCif5JN1IlbNgWxO8Dx",
          "name": "Shrieking Charge.",
          "description": "The Angry moves up to 1 Area as part of this Action towards the Creature that most recently took hostile action against it and makes a Hook Hands Attack.\n\nEach Creature within 2 Areas that can hear The Angry must make a Grit Check or be forced to take the Attack Action targetting The Angry on their next Turn.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "CQTDpBZEr2XbJ9AIiaUz",
          "name": "Two Heads.",
          "description": "The Angry has an Edge on Checks and Contests against being Blinded/Deafened, Terrified, Toppled, or being made to act against its will.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "1G1bRhqKglrl1bdBqstQ",
          "name": "Pacifism Weakness.",
          "description": "If a Creature within 1 Area takes no hostile Action on its Turn, The Angry takes 1 Damage.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "IgMBK9wghKf88kdf2FVY",
          "name": "Rising Fury.",
          "description": "Whenever The Angry takes Damage from a source other than its Pacifism Weakness, its Fury increases by 1 level. When The Angry deals Damage, its Fury decreases by 1 level.\n- Level 1: Seething - The Angry suffers a Snag on Attacks made on Creatures other than itself.\n- Level 2: Enraged - The Angry has an Edge on Attacks.\n- Level 3: Maddened - The Angry has an Edge on Attacks and its Attacks deal an additional 2 Damage.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "kxyfnPz8MwbosRE2BSjN",
          "name": "Vicious Outburst.",
          "description": "When The Angry becomes Maddened, it immediately moves 1 Area and makes a single Attack.",
          "value": 0,
          "counters": {},
          "modifiers": []
        }
      ],
