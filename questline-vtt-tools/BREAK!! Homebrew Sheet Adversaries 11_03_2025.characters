      "bio": {
        "background": "Created by: Skig",
        "size": "Small",
        "name": "Bristle",
        "subname": "Rank 0 Mook",
        "tokenCrop": "",
        "details": "A bristle is a furious little seed monster about the size of a Chib. They are created when bright energy seeps into a seed, granting it a temporary, and rather vigorous sentience. Limbs of tough and limber root sprout from the central seed, and also form a simple face above to form an angry little warrior that seems to want nothing more than to die in glorious battle. They have a distinctive scent, like cinnamon and wood sap.\r",
        "appearance": "",
        "characteristics": {
          "height": "",
          "skin": "",
          "weight": "",
          "age": "",
          "eyes": "",
          "hair": "",
