      "abilities": [
        {
          "id": "9V4D7sN3iZ2wk9lFcY09",
          "name": "False Appearance [B].",
          "description": "While the gargoyle remains motionless, it is indistinguishable from an inanimate object.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "0tVgQ93gmH7XpG3xk6SU",
          "name": "Faultless Tracker [B].",
          "description": "The Creature that caused the Tower Dragon to animate becomes its \u201cquarry\u201d. The  Tower Dragon knows the direction and distance to its quarry as long as they are within 160 feet of its protected location or the  Tower Dragon is destroyed. Inorganic creatures like Bio-Mechanoids don\u2019t seem to trigger this, though.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "4OFkDXpbebktNUgW9yKj",
          "name": "Rejuvenation [A].",
          "description": "If the Tower Dragon is destroyed, it reforms with all of its Hearts in 1 Hour unless its remains fully disintegrated or turned to dust.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "Oahz9Eq5MvyeDj0SfBel",
          "name": "Magic Resistance [A].",
          "description": "The Tower Dragon has an Edge on all Checks made to resist Magical Abilities.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "SZAGr927zdd0NkIDZtOA",
          "name": "Immutable Form [A].",
          "description": "The Tower Dragon is immune to all Magical Abilities that alter its form, like Chibification or Jellyfication.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "rXdfDBEtd7OhpXIzpIZt",
          "name": "Lightning Breath [A]\nThe Tower Dragon blasts out lightning from its mouth at a Target.",
          "description": "Requires a Deftness Check\nSuccess: The Target only takes 1 Lightning Damage.\nFailure: The Target takes 3 Lightning Damage.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "ZIkaN4PueLfxpXdPkHT4",
          "name": "Repulsion Breath [B].",
          "description": "The tower dragon pushes a Target backwards with a concussive blast of magic.\n\nRequires a Might Check\nFailure: The Target is pushed back by 2 Areas.",
          "value": 0,
          "counters": {},
          "modifiers": []
        }
