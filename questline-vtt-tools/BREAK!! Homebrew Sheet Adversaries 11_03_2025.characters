      "abilities": [
        {
          "id": "byUqD97VaOqep3Kzguv5",
          "name": "Vexing Prick.",
          "description": "As an Action, the Rose Lalka can poise itself to prick a Target with their thorns at just the right moment. Grants a Target making an Attack within the same Area a Snag.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "zSjL7ipbSCZeFQqYzIyu",
          "name": "Arcane Beleaguerment.",
          "description": "Lalka can hurl themselves at you in a self-destructive attempt to slow you down. Whether the attempt is successful or not, the Lalka withers and is destroyed.\nRequires a Deftness v. Grit Contest. On a Success, the Lalka wraps its thorns around a limb and inflicts Corrupted Blood.\nUp to 3 Lalka can attempt this Ability together, each Lalka adds +2 to their Contest roll and prolongs the effect by 1 Turn.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "8sxCdZUGZVjFlfqA39zB",
          "name": "Ailment: Corrupted Blood.",
          "description": "While affected:\r\n- Attempts to resist Magical Abilities are at a Snag.\r\n- Using Magical Abilities requires a successful Grit Check. If the Ability already had a Check to use it, it is now made with a Snag.",
          "value": 0,
          "counters": {},
          "modifiers": []
        }
      ],
