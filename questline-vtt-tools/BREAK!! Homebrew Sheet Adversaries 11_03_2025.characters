      "abilities": [
        {
          "id": "lFqllY65GePgfqIzfhBm",
          "name": "Freeze Frame!",
          "description": "As an Action, the Petrikite can expose its central glyph, pulsing out a petrifying wave.\r\nRequires a Grit Check or become Petrified to a lovely coffee-grain wood (14 Defense Rating, 6 Hearts).\r\nThis Ability can only be attempted on a given Target once during a Fight, including across multiple Petrikites.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "YmSDVVF8F00XfFX6S92A",
          "name": "The Joy of Sundering.",
          "description": "The sound of woodpecking can be rather horrific if your friend is the tree.\r\nIf the Petrikite petrifies a Target successfully, the whole flock will swarm it.\r\nAs an Action, the Petrikite rapidly pecks at the Target, automatically dealing 1 Damage.",
          "value": 0,
          "counters": {},
          "modifiers": []
        }
