      "abilities": [
        {
          "id": "cQbbDmvetX8t1RhYxyQ6",
          "name": "Radiant Arms.",
          "description": "A Bristle is able to channel bright energy into a simple twig to form a weapon. This takes an Action and lasts for 24 hours. The weapon is a Standard Weapon that deals Bright Damage.\r\nAdds 1 Bright Allegiance.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "sC359vSBb9fcZzw1Sin9",
          "name": "Radiant Vigour.",
          "description": "The bright energy inside a Bristle makes it almost too vigorous to die, occasionally one will spring back from sure death. When reduced to 0 Hearts, it has a 10% chance to regain 1 Heart.\r\nAdds 1 Bright Allegiance.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "fxvDHwGAyxhwSFSljFtY",
          "name": "Flammable.",
          "description": "Bristle are dry and flammable. Any damage caused by Fire will cause an additional Heart of Damage, though typically they have only 1 Heart.",
          "value": 0,
          "counters": {},
          "modifiers": []
        }
