        "items": [
          {
            "id": "jRus4UMMRbRecdaTomws",
            "itemId": "PYIy4bcAgtvghEuZ2ADO",
            "name": "Therapod Hide",
            "description": "3 Slots of hide can be removed with the right ability. This tough material can be used to make Light or Medium armour and grants the Crafter a Minor Bonus on their Crafting Check.",
            "type": "none",
            "privacy": {
