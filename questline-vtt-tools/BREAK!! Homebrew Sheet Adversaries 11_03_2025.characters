      "bio": {
        "background": "Created by: ichiCharmed [Discord]",
        "size": "Large",
        "name": "Dragon, Tower",
        "subname": "Rank 5 Mega-Boss",
        "tokenCrop": "",
        "details": "Never send a gargoyle to a dragon\u2019s job. When gargoyles and other smaller constructs fail, or one wishes to err on the side of caution, one with enough finances can commission the creation and enchantment of this well chiseled creature of stone scales.",
        "appearance": "Movement types: Land, Flying",
