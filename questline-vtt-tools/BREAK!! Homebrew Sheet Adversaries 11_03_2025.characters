      "attack-bonus": {
        "attributes": {
          "attack-bonus": {
            "value": {
              "visible": true,
              "value": 8
            }
          }
        }
      },
      "notes": [
        {
          "description": "The Dominatelio Anax is extremely territorial. It primarily targets foes either due to them being in its territory or looking like prey. If there is more than one target, it often strikes with its tail first, then focuses on larger opponents with its jaws. While it has no innate ability to sense magic, it appears to have a strong hatred for it. Once an opponent has attempted a Magical Ability on it, it will relentlessly attack that opponent to the almost total exclusion of everything else. It is not known what causes such a visceral reaction. While scholars would love to study this in more detail, conventional wisdom advises that fleeing the rampaging beast is the correct response.",
          "counterOverrides": {},
          "rollDetails": [],
          "id": "DBMa0akRFxeJjA4o7MVe",
          "type": "Quick Facts",
          "originId": "tactics",
          "counters": {},
          "modifiersPostCalculationFunc": null,
