      "bio": {
        "background": "Created by: ichiCharmed [Discord]",
        "size": "Massive",
        "name": "Atropal",
        "subname": "Rank 7 Mega-Boss",
        "tokenCrop": "",
        "details": "Undead god fetus. The unfinished fetus of an evil deity pulled early from the primordial womb of existence, left to float adrift in the void. Never truly alive, not even the power of a god could bring true life into this hideously awful horror.",
        "appearance": "",
        "characteristics": {
          "height": "",
          "skin": "",
          "weight": "",
