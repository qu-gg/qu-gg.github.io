      "abilities": [
        {
          "id": "wxn567XI9rvERdn7f9VQ",
          "name": "House Cat.",
          "description": "- The Cat is a Massive Species (p434)\n- Sweep Attack: its paws or tail strike as Arc Weapons.\n- Focus Attack: its bite or tail strikes as Mighty Weapons.",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "KNLgt9dkdNTsVwOJ2Fi9",
          "name": "Nine Lives Old.",
          "description": "- Edge on all Insight Checks/Contests involving hearing or smell.\n- Nine Lives: When the Cat is reduced to 0 Hearts, roll a D20. On a 9 or lower, they regain their Heart Total. This is reduced permanently by 1 for its remaining lives (e.g., 8, 7, ...).",
          "value": 0,
          "counters": {},
          "modifiers": []
        },
        {
          "id": "xyaYbDnryRiRUqzyfioj",
          "name": "Might Pounce.",
          "description": "- The Cat has Supernatural Leaping.\n- Leaping Strike: In addition to other permitted Actions on its Turn, the Cat can Attack a Target up to 2 Areas away, dealing 2 Damage on a Hit.\n\nRequires a Might Check for all Targets in the Zone, failure results in being Toppled.",
          "value": 0,
          "counters": {},
          "modifiers": []
        }
      ],
