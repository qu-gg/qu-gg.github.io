      "bio": {
        "background": "Created by: KeJoRo [Discord]",
        "size": "Massive",
        "name": "Pum King",
        "subname": "Rank 5 Mega-Boss",
        "tokenCrop": "",
        "details": "Maliformis Monarch. Resembling a titanic version of a Pum Kin's head, some scholars nevertheless believe this is a coincidence and that the two have little to do with each other. The Pum Kin, for their part, seem to neither know nor care, while Pum Kings, being both mute and aggressive, cannot be questioned.",
        "appearance": "",
        "characteristics": {
          "height": "",
          "skin": "",
          "weight": "",
          "age": "",
          "eyes": "",
          "hair": "",
          "gender": ""
        },
        "profileImage": null
      },
      "defense-rating": {
