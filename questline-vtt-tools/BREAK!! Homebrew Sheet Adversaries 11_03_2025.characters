          "value": 0,
          "linkedValue": null,
          "modifiersPostCalculationFunc": null,
          "counters": {},
          "description": "Grumpy but not mean about it, give them a pet and a treat and they purr like a kitten.",
          "name": "Role Playing Notes",
          "counterOverrides": {},
          "rollDetails": [],
