        "value": {
          "description": "Range: 1 Area\nDamage: 1\nThreshold: 22\n\n**Weapon Ability, Crack!**\nYou can Attack an enemy up to 1 Battlefield Area away."
        }
      },
      {
        "visibility": "full",
