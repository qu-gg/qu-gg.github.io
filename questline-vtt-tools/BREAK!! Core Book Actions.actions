              "width": 100,
              "y": 0,
              "unit": "%",
              "height": 100
            }
          }
        },
        "visibility": "full",
        "type": "image"
      },
      {
        "type": "description",
        "visibility": "full",
        "value": {
          "description": "*You are a master of a swift and fluid martial art, able to protect yourself and strike fatal blows even without a weapon.*\n\nYou make Unarmed attacks as if wielding a Quick Weapon.\n\n**Weapon Ability, Darting Style:**\nYou gain a +1 to your Defense Rating when using a Quick Weapon."
        }
      }
    ],
