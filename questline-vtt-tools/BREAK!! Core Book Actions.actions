      "users": [],
      "level": "private"
    },
    "subtype": "raider",
    "version": 2,
    "displayName": "[A] Spell Cutter",
    "details": [
      {
        "visibility": "full",
        "value": {
          "image": {
            "tokenCrop": {
              "unit": "%",
              "y": 0,
              "height": 100,
              "aspect": 1,
              "width": 100,
              "x": 0
            },
            "url": "https://firebasestorage.googleapis.com/v0/b/rpg-pbp.appspot.com/o/games%2F1WLk8WgaysyvKtNs5P0a%2Fimages%2F8FwX0SvsvpwYnYfrTNTO.png?alt=media&token=9f94a9a7-a02d-4f3c-be8c-f1e26d3cea59"
          }
        },
        "type": "image"
      },
      {
        "type": "description",
        "visibility": "full",
        "value": {
          "description": "*While imperceptible to regular folk, your eyes can distinguish the tiny distortions in the air created by coalescing mana. A well placed swipe can sometimes disrupt a spell’s formation.*\n\nYou can attempt to nullify a Magic Ability that has targeted you, or an ally in the same Battlefield Area.\n\n**Requires a Contest**\nYour Deftness vs. the Aptitude related to the magical Ability’s use. \nIf no Aptitude is specified, then use the caster’s Aura.\n**Success**: The spell is shattered and does not affect its intended targets.\n\nSuccessful or not, you cannot act during your next Turn."
        }
      }
    ],
    "type": "abilities",
    "effects": [],
    "id": "CCzU1KnFmPgHUopqBTHa"
  },
  {
    "details": [
      {
        "value": {
          "image": {
            "tokenCrop": {
              "width": 100,
              "x": 0,
              "aspect": 1,
              "height": 100,
