              "unit": "%",
              "y": 0
            }
          }
        },
        "visibility": "full"
      }
    ],
    "displayName": "Thrown Weapon",
    "version": 2
  },
  {
    "type": "abilities",
    "effects": [],
    "details": [
      {
        "type": "image",
        "visibility": "full",
        "value": {
          "image": {
            "url": "https://firebasestorage.googleapis.com/v0/b/rpg-pbp.appspot.com/o/games%2F1WLk8WgaysyvKtNs5P0a%2Fimages%2FLwU17ukUY218hdZ5r4j8.png?alt=media&token=5d7bcc84-df61-4234-916d-e1957d8859df",
            "tokenCrop": {
              "aspect": 1,
              "width": 100,
              "x": 0,
              "unit": "%",
              "y": 0,
              "height": 100
            }
          }
        }
      },
      {
        "type": "description",
        "visibility": "full",
        "value": {
          "description": "*You can agitate the ambient mana inside another creature, causing it to swell and expand. Performing the spell requires you to make an exaggerated gesture; exhaling a deep breath into your own thumb. Huuffff!*\n\nYou can attempt to inflate a single enemy from up to 1 Battlefield Area away.\n\n**Requires a Contest**\nYour Insight vs. your target’s Grit. \n**Success:** Your target begins to bloat. By the start of their next Turn they will be afflicted by the Ballooned Ailment.\n\nOnly one creature may be affected by this Ability at any time. If you target another individual, the previous target will return to normal size. Otherwise, the affliction wears off after an hour or if you will it away."
        }
      },
      {
        "type": "range",
        "visibility": "full",
        "value": {
          "range": "Gain 1 Dark Allegiance Point."
        }
      }
    ],
    "version": 2,
    "subtype": "sage",
    "displayName": "[S][M] Mortifying Bloat",
    "privacy": {
      "level": "private",
      "users": []
    },
    "id": "tLR70eh2JZTl1ESjP1tm"
  },
  {
    "type": "abilities",
    "effects": [],
    "details": [
      {
        "type": "image",
        "visibility": "full",
        "value": {
          "image": {
            "url": "https://firebasestorage.googleapis.com/v0/b/rpg-pbp.appspot.com/o/games%2F1WLk8WgaysyvKtNs5P0a%2Fimages%2FU5vD1BJuto1FFJpws6wQ.png?alt=media&token=36a9ca31-c50a-4234-8b2a-5046d44229bc",
            "tokenCrop": {
              "aspect": 1,
              "width": 100,
              "x": 0,
              "unit": "%",
              "y": 0,
              "height": 100
            }
          }
        }
      },
      {
        "type": "description",
        "value": {
          "description": "*You refuse to be broken.*\n\nWhen reduced to 0 Hearts or below, you can attempt to find some extra vitality.\n\n**Requires a Grit Check**\n**Success**: You recover half your maximum Hearts Total, rounded up.\n\nThis ability does not remove any Injuries incurred."
        },
        "visibility": "full"
      }
    ],
    "subtype": "champion",
    "displayName": "[A] Indomitable",
    "version": 2,
    "privacy": {
      "level": "private",
      "users": []
    },
    "id": "uoQfwMdhyuAAMaE0gCTS"
  },
  {
    "details": [
      {
        "type": "image",
        "value": {
          "image": {
            "tokenCrop": {
              "height": 100,
              "y": 0,
              "unit": "%",
              "x": 0,
              "width": 100,
              "aspect": 1
            },
            "url": "https://firebasestorage.googleapis.com/v0/b/rpg-pbp.appspot.com/o/games%2F1WLk8WgaysyvKtNs5P0a%2Fimages%2FflqYVIb2ogI1lHC5lczu.png?alt=media&token=373ea591-58b1-4e60-bb1a-27c2db64ccef"
          }
        },
        "visibility": "full"
      },
      {
        "visibility": "full",
        "value": {
          "description": "*You levelled up your Sidestep. Now, as your enemies find themselves striking thin air, you take up a more advantageous position.*\n\nYou can now move to an adjacent Battlefield Area, or a more strategic place in the same Area, whenever you use your Sidestep.\n- All other Sidestep restrictions apply.\n\nThis Ability does not allow you to move to an Area you could not normally enter."
        },
        "type": "description"
      }
    ],
    "version": 2,
    "displayName": "[A] Flash Step",
    "subtype": "raider",
    "type": "abilities",
    "effects": [],
    "privacy": {
      "users": [],
      "level": "private"
    },
    "id": "wD9dJ7tyNmXsFX40iDuh"
  },
  {
    "privacy": {
      "level": "private",
      "users": []
    },
    "version": 2,
    "displayName": "[S] Sidestep",
    "subtype": "raider",
    "details": [
      {
        "visibility": "full",
        "value": {
          "image": {
            "tokenCrop": {
              "aspect": 1,
              "width": 100,
              "x": 0,
              "unit": "%",
              "y": 0,
              "height": 100
            },
            "url": "https://firebasestorage.googleapis.com/v0/b/rpg-pbp.appspot.com/o/games%2F1WLk8WgaysyvKtNs5P0a%2Fimages%2FTnWfUdS0ukIfYnKe9FIv.png?alt=media&token=c6ef8d3b-aa79-463c-8066-d0da837b5788"
          }
        },
        "type": "image"
      },
      {
        "type": "description",
        "visibility": "full",
        "value": {
          "description": "*Anyone trying to strike you finds it trickier than it ought to be. You are an elusive opponent, able to twist away from a devastating strike at the very last moment.*\n\nOnce per Fight you can Sidestep an Attack or Ability that would normally have hit you.\n- You can Sidestep any Attack that could be feasibly avoided with a last second manoeuver.\n  - For example, avoiding a sword thrust with a nonchalant turn of your head or shielding your eyes from a mesmerising gaze.\n- The Sidestep prevents an Attack from connecting with or affecting you. \n\nYou’ll need freedom to move and adequate space to execute your Sidestep."
        }
      }
    ],
    "type": "abilities",
    "effects": [],
    "id": "xYhDmJaoydIDJf185Si8"
  },
