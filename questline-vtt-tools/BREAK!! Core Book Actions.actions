        "value": {
          "image": {
            "url": "https://firebasestorage.googleapis.com/v0/b/rpg-pbp.appspot.com/o/games%2F1WLk8WgaysyvKtNs5P0a%2Fimages%2FC6TPTU5MUTYVZdkrSrfL.png?alt=media&token=f7d96ff4-4a7a-49de-9502-e10d77389cbd",
            "tokenCrop": {
