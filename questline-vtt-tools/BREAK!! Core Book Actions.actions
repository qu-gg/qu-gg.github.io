  },
  {
    "details": [
      {
        "type": "image",
        "visibility": "full",
        "value": {
          "image": {
            "url": "https://firebasestorage.googleapis.com/v0/b/rpg-pbp.appspot.com/o/games%2F1WLk8WgaysyvKtNs5P0a%2Fimages%2FFnNmCnKgCxoqK6uJPBIT.png?alt=media&token=46aae07c-327a-4427-b8ea-77b3b8b19490",
