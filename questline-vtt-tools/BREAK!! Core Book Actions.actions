      {
        "value": {
          "description": "Range: 2 Areas\nDamage: 1\nThreshold: 20\nLoading Time: Same Action\n\nYou must use two hands while wielding a Drawn Missile Weapon.\n\nAmmo: x5 per 0.5 Slots"
        },
        "visibility": "full",
        "type": "description"
      },
      {
        "type": "image",
        "visibility": "full",
        "value": {
          "image": {
            "tokenCrop": {
              "x": 0,
              "width": 100,
              "aspect": 1,
