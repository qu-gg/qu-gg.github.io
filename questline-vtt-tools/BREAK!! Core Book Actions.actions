    },
    "effects": [],
    "type": "abilities",
    "details": [
      {
        "visibility": "full",
        "value": {
          "image": {
            "tokenCrop": {
              "height": 100,
              "unit": "%",
              "y": 0,
              "width": 100,
              "x": 0,
              "aspect": 1
            },
            "url": "https://firebasestorage.googleapis.com/v0/b/rpg-pbp.appspot.com/o/games%2F1WLk8WgaysyvKtNs5P0a%2Fimages%2F9BIKNraPfZbfvtH475gv.png?alt=media&token=546ef8d2-a644-45ca-8e94-797143250a6c"
          }
        },
        "type": "image"
      },
      {
        "type": "description",
        "visibility": "full",
        "value": {
          "description": "*Your strikes can create opportunities for your comrades-at-arms to exploit.*\n\nIf one of your Attacks is successful, it also counts as an Attack Assist for the next ally attacking the same opponent."
        }
      }
    ],
    "displayName": "[A] At Your Side",
    "subtype": "battle princess",
