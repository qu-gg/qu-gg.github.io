      "level": "private"
    },
    "details": [
      {
        "visibility": "full",
        "value": {
          "image": {
            "url": "https://firebasestorage.googleapis.com/v0/b/rpg-pbp.appspot.com/o/games%2F1WLk8WgaysyvKtNs5P0a%2Fimages%2F2TmcUnDWj1QjKNrHMm85.png?alt=media&token=55af5c92-e577-40db-87ee-f9dd8a900a34",
            "tokenCrop": {
              "unit": "%",
              "y": 0,
              "height": 100,
              "aspect": 1,
              "width": 100,
              "x": 0
            }
          }
        },
        "type": "image"
      },
      {
        "type": "description",
        "value": {
          "description": "*Your Wrath’s Blade does not always burn with rage, sometimes it is chillingly dispassionate.*\n\n**Frost Damage**: Your Wrath’s Blade has iced over and now does Frost Damage.\n\n**Freezing Blow**: After a successful Attack, the ice can be discharged to freeze one of your opponent’s limbs. The chosen limb is Restrained until your opponent, or someone trying to assist them, makes a successful Might Check to break free. This exhausts the Ability. \n\nFrost Blade can only be used once per Fight.\n"
        },
        "visibility": "full"
      },
      {
        "type": "range",
        "value": {
          "range": "Gain 1 Dark Allegiance Point."
        },
        "visibility": "full"
      }
    ],
    "version": 2,
    "displayName": "[S][M] Frost Blade",
    "subtype": "murder princess",
