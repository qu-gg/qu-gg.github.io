      "level": "private"
    },
    "details": [
      {
        "type": "image",
        "value": {
          "image": {
            "tokenCrop": {
              "height": 100,
              "unit": "%",
              "y": 0,
              "width": 100,
              "x": 0,
              "aspect": 1
            },
            "url": "https://firebasestorage.googleapis.com/v0/b/rpg-pbp.appspot.com/o/games%2F1WLk8WgaysyvKtNs5P0a%2Fimages%2FdJwCtjP4Bb4a3f2suTeg.png?alt=media&token=dba082a5-e19f-476c-98b2-c06c0e19baff"
          }
        },
        "visibility": "full"
      },
      {
        "value": {
          "description": "*When surrounded by lesser warriors you enter Counter Fang stance. From this meditative state you visualise the flow of the fight and then, when engaged by predictable foes, you lay waste to them with choreographed efficiency.*\n\nDuring a Fight you can choose to enter the Counter Fang stance instead of making an Attack or taking another Action.\n\nWhile in the Counter Fang stance, any opponent that fails their Attack roll on you is subject to a retaliatory Attack, Attack Stunt, or Combat Trick.\n\nThe benefit of this Ability lasts until the start of your next Turn, when you can move and re-enter the Counter Fang stance if desired."
        },
        "visibility": "full",
        "type": "description"
      }
    ],
    "displayName": "[A] Counter Fang",
    "version": 2,
    "subtype": "raider",
    "effects": [],
    "type": "abilities",
    "id": "FQFbwuBKlglWr2qJdC3s"
  },
  {
    "effects": [],
    "type": "abilities",
    "subtype": "murder princess",
    "version": 2,
    "displayName": "[A][M] Blade of Darkness",
    "details": [
      {
        "value": {
          "image": {
            "tokenCrop": {
              "aspect": 1,
              "x": 0,
              "width": 100,
              "y": 0,
              "unit": "%",
              "height": 100
            },
            "url": "https://firebasestorage.googleapis.com/v0/b/rpg-pbp.appspot.com/o/games%2F1WLk8WgaysyvKtNs5P0a%2Fimages%2FtqQjcOy1DKSSu8hQYjDc.png?alt=media&token=33da645c-3a60-43ee-9e77-d7d047f3d138"
          }
        },
        "visibility": "full",
        "type": "image"
      },
      {
        "value": {
          "description": "*You can summon a Wrath’s Blade composed of pure dark energy, capable of wounding the soul.*\n\nYou can activate this Ability at will upon summoning your Wrath’s Blade.\n\n**Dark Strike**: Your Wrath’s Blade is a cosmic void that now drains an additional Heart of Dark Damage in addition to the weapon’s Mundane Damage.\n\n**Wrapped in Darkness**: After a strike with the Wrath’s Blade, the energy can be discharged to engulf your target and cause an additional Heart of Dark Damage; which dispels the Ability.\n\nUsing Wrapped in Darkness prevents you from using this Ability again for another 24 hours."
        },
        "visibility": "full",
        "type": "description"
      },
      {
        "visibility": "full",
        "value": {
          "range": "Gain 1 Dark Allegiance Point."
        },
        "type": "range"
      }
    ],
    "privacy": {
      "level": "private",
      "users": []
    },
    "id": "FulXd0AuEyNB8KuQfQr3"
  },
