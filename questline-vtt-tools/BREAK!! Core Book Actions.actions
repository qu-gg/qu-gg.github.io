              "x": 0,
              "width": 100,
              "aspect": 1,
              "height": 100,
              "y": 0,
              "unit": "%"
            }
          }
        }
      },
      {
        "visibility": "full",
        "value": {
          "description": "*While a one-on-one fight is not an attractive proposition to you, ganging up on someone certainly is.*\n\nDuring a Fight, you gain a Minor Bonus (+2) on your Attack rolls against opponents who are being attacked by another character in the same Turn."
        },
        "type": "description"
      }
    ],
