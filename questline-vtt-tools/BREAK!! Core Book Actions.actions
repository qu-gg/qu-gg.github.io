    "effects": [],
    "privacy": {
      "level": "private",
      "users": []
    },
    "id": "dmgO0tLBVR04JcNanQy7"
  },
  {
    "type": "abilities",
    "effects": [],
    "details": [
      {
        "type": "image",
        "value": {
          "image": {
            "url": "https://firebasestorage.googleapis.com/v0/b/rpg-pbp.appspot.com/o/games%2F1WLk8WgaysyvKtNs5P0a%2Fimages%2FA2G3qoknLOSR6Xh55mic.png?alt=media&token=e55c8547-ed08-4cec-a821-4231ff6ff231",
            "tokenCrop": {
              "y": 0,
              "unit": "%",
              "height": 100,
              "aspect": 1,
              "x": 0,
              "width": 100
            }
          }
        },
        "visibility": "full"
      },
      {
        "type": "description",
        "visibility": "full",
        "value": {
          "description": "*You aren’t the best shot or the biggest hitter — but sometimes it’s all about timing.*\n\nYou have an Edge on all Attack rolls made when you’ve chosen to React."
        }
      }
    ],
