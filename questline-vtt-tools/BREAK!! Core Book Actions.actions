    "type": "abilities",
    "effects": [],
    "displayName": "[A][M] Queen Amhika",
    "version": 2,
    "subtype": "heretic",
    "details": [
      {
        "type": "image",
        "visibility": "full",
        "value": {
          "image": {
            "tokenCrop": {
              "x": 8.66666666666666,
              "width": 86.33333333333333,
              "aspect": 1,
              "height": 86.33333333333333,
              "y": 5.999999999999993,
              "unit": "%"
            },
            "url": "https://firebasestorage.googleapis.com/v0/b/rpg-pbp.appspot.com/o/games%2F1WLk8WgaysyvKtNs5P0a%2Fimages%2FmIBenivvWYRYFGVuIG3c.png?alt=media&token=de37f9d5-cea0-458c-89da-4ac990a843a9"
          }
        }
      },
      {
        "value": {
          "description": "*Queen Amhika, Dweller in Our Hearts, is pleasant and obliging. Her soothing voice and kind embrace will transport you to a place of safety.*\n\nWith an earnest desire Queen Amhika will appear ready to remove you from harms way. Summoning is instantaneous.\n- Queen Amhika will envelop you, and up to 5 allies, in her enormous cape. \n- You drift off into a peaceful sleep. When you awake you are in the place where you always felt most safe.\n- You should choose your safe place before play and inform your GM. This could be your waterfall retreat, a relaxing meadow, or your childhood home.\n\nOnce Amhika has deposited you safely she cannot be summoned again until you have spent one day actually relaxing."
        },
        "visibility": "full",
        "type": "description"
      },
      {
        "type": "range",
        "visibility": "full",
        "value": {
          "range": "Gain 1 Bright Allegiance Point."
        }
      }
    ],
    "id": "O0PumD0h3g7xTzaSLOZa"
  },
