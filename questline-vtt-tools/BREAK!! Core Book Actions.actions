    },
    "id": "nBerIuKppCyFRNEKeJH5"
  },
  {
    "privacy": {
      "level": "private",
      "users": []
    },
    "effects": [],
    "type": "abilities",
    "details": [
      {
        "visibility": "full",
        "value": {
          "image": {
            "url": "https://firebasestorage.googleapis.com/v0/b/rpg-pbp.appspot.com/o/games%2F1WLk8WgaysyvKtNs5P0a%2Fimages%2FukhKIK3VNzRXZgaDGk21.png?alt=media&token=db4cbd3e-4fc4-43a9-a745-ccad1148cc8b",
            "tokenCrop": {
              "height": 100,
              "unit": "%",
              "y": 0,
              "width": 100,
              "x": 0,
              "aspect": 1
            }
          }
        },
        "type": "image"
      },
      {
        "value": {
          "description": "*You can use malicious mana to infect your foes with a debilitating disease. Symptoms include purple spots, mana vulnerability and utter exhaustion.*\n\nYou can attempt to infect someone up to 15 ft, or 1 Battlefield Area, away with Hocus Pox.\n\n**Requires a Contest**\nYour Insight vs. your target’s Grit.\n**Success:** Your target contracts Hocus Pox and they break out in purple spots.\n- Victims have a Snag when making rolls to resist other Magical Abilities.\n- Victims are afflicted with the Putrefied Ailment.\n- When a victim is reduced to 0 Hearts by this Ailment, they collapse and are helplessly exhausted. This will pass with a week’s worth of rest, but the purple spots remain for another week. \n\nOnce a chosen target has fallen foul of this Ability, you cannot use it again for another 24 hours."
        },
        "visibility": "full",
        "type": "description"
      },
      {
        "type": "range",
        "visibility": "full",
        "value": {
          "range": "Gain 1 Dark Allegiance Point."
        }
      }
    ],
    "subtype": "sage",
    "version": 2,
    "displayName": "[S][M] Hocus Pox",
    "id": "nVxYj3xO7sqfezh1nRee"
  },
