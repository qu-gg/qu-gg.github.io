    "version": 2,
    "details": [
      {
        "visibility": "full",
        "value": {
          "description": "Range: 2 Areas\nDamage: 1\nThreshold: 18\nLoading Time: 1 Action\n\nYou must use two hands to load and fire these Weapons.\n\n**Weapon Ability, Thunderous Shot:**\nYou gain a +2 to your Attack roll.\n\nAmmo: 3x per 1/10 Slots."
        },
        "type": "description"
      },
      {
        "value": {
