    "details": [
      {
        "visibility": "resultsOnly",
        "type": "table",
        "value": {
          "table": {
            "baseRoll": "1d20",
            "name": "Injury Table",
            "rows": [
              {
                "showDescription": true,
                "result": "Shocked/Stalled",
                "description": "- Miss your next Combat Turn.",
                "range": {
                  "start": 1,
                  "end": 5
                }
              },
              {
                "showDescription": true,
                "result": "Armor Crash",
                "description": "- Your armor’s Defense Bonus is reduced by 2. This penalty lasts until your armor is repaired. \n- When your Armor Bonus is reduced to 0, your armor is destroyed. \n- If you are not wearing armor, count this Injury as Wounded.",
                "range": {
                  "end": 10,
                  "start": 6
                }
              },
              {
                "description": "- Your maximum Hearts Total is reduced by 1 until you receive Treatment for this Injury.\n- If this Injury reduces your Hearts Total to 0, count this Injury as Quiet Death.",
                "showDescription": true,
                "result": "Wounded",
                "range": {
                  "start": 11,
                  "end": 14
                }
              },
              {
                "result": "Broken Arm",
                "showDescription": true,
                "description": "- Roll to see which arm is broken (1-10 right arm, 11-20 left arm).\n- Your Might Aptitude is halved when making Checks or Contests requiring the use of your arms until you receive Treatment for this Injury.\n- If this Injury occurs on the same limb a second time, count this Injury as Severed.",
                "range": {
                  "end": 16,
                  "start": 15
                }
              },
              {
                "result": "Broken Leg",
                "showDescription": true,
                "description": "- Roll to see which leg is broken (1-10 right leg, 11-20 left leg).\n- Your Speed Rating is reduced by a single step.\n- You suffer a Snag on all Might and Deftness Aptitude Checks and Contests requiring the use of your legs until you receive Treatment for this Injury.\n- If this injury occurs on the same limb a second time, count this Injury as Severed.",
                "range": {
                  "start": 17,
                  "end": 18
                }
              },
              {
                "range": {
                  "start": 19,
                  "end": 20
                },
                "showDescription": true,
                "description": "- You fall to the ground and can no longer participate in the Fight. You will regain consciousness once the Fight is over and suffer no lasting damage.\n- An enemy can slay you immediately if they are unhindered and use their Turn to do so. \n- If you receive First Aid you will be revived but cannot use any Combat Actions for the remainder of the Fight.",
                "result": "Out Cold"
              }
            ]
          }
        }
      },
      {
        "visibility": "full",
