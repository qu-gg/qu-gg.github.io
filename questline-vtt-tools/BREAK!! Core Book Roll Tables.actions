    "version": 2,
    "details": [
      {
        "visibility": "resultsOnly",
        "type": "table",
        "value": {
          "table": {
            "rows": [
              {
                "range": {
                  "start": 1,
                  "end": 3
                },
                "result": "Shocked/Stalled",
                "showDescription": true,
                "description": "- Miss your next Combat Turn."
              },
              {
                "description": "- Your armor’s Defense Bonus is reduced by 2. This penalty lasts until your armor is repaired. \n- When your Armor Bonus is reduced to 0, your armor is destroyed. \n- If you are not wearing armor, count this Injury as Wounded.",
                "showDescription": true,
                "result": "Armor Crash",
                "range": {
                  "start": 4,
                  "end": 6
                }
              },
              {
                "range": {
                  "end": 9,
                  "start": 7
                },
                "showDescription": true,
                "description": "- Your maximum Hearts Total is reduced by 1 until you receive Treatment for this Injury.\n- If this Injury reduces your Hearts Total to 0, count this Injury as Quiet Death.",
                "result": "Wounded"
              },
              {
                "range": {
                  "end": 11,
                  "start": 10
                },
                "showDescription": true,
                "description": "- Roll to see which arm is broken (1-10 right arm, 11-20 left arm).\n- Your Might Aptitude is halved when making Checks or Contests requiring the use of your arms until you receive Treatment for this Injury.\n- If this Injury occurs on the same limb a second time, count this Injury as Severed.",
                "result": "Broken Arm"
              },
              {
                "range": {
                  "start": 12,
                  "end": 13
                },
                "description": "- Roll to see which leg is broken (1-10 right leg, 11-20 left leg).\n- Your Speed Rating is reduced by a single step.\n- You suffer a Snag on all Might and Deftness Aptitude Checks and Contests requiring the use of your legs until you receive Treatment for this Injury.\n- If this injury occurs on the same limb a second time, count this Injury as Severed.",
                "result": "Broken Leg",
                "showDescription": true
              },
              {
                "range": {
                  "start": 14,
                  "end": 15
                },
                "result": "Out Cold",
                "description": "- You fall to the ground and can no longer participate in the Fight. You will regain consciousness once the Fight is over and suffer no lasting damage.\n- An enemy can slay you immediately if they are unhindered and use their Turn to do so. \n- If you receive First Aid you will be revived but cannot use any Combat Actions for the remainder of the Fight.",
                "showDescription": true
              },
              {
                "result": "Near Death",
                "description": "- You’ll die within 2 Turns if help doesn’t arrive.\n- First Aid reduces this Injury to Wounded.",
                "showDescription": true,
                "range": {
                  "end": 17,
                  "start": 16
                }
              },
              {
                "range": {
                  "end": 18,
                  "start": 18
                },
                "description": "- Roll to see which limb is severed (1-5 right arm, 6-10 left arm, 11-15 right leg, 16-20 left leg)\n- You’ll need Magical Treatment or a Prosthetic Replacement to regain the limb’s function.\n- Until replaced, consider a severed arm as the Broken Arm Injury, and a severed leg as the Broken Leg Injury, except you obviously cannot use your severed limb at all.\n- Re-roll if the limb has already been severed and not been replaced. If you have no limbs left, you’ve been decapitated and are dead.",
                "showDescription": true,
                "result": "Severed"
              },
              {
                "showDescription": true,
                "description": "- You’ll die within 2 Turns if help doesn’t arrive.\n- First Aid will prevent your death but... you suffer a -1 penalty to an Aptitude of your choice which is related to the wound. For example, -1 Insight for a head blow.\n- Bio-Mechanoid? You lose your Robotic Quirk. The second time your receive this Injury, suffer the Aptitude penalty above. \n- Magical/Advanced Treatment is required to remove the lasting effect of the Injury.",
                "result": "Mutilated",
                "range": {
                  "start": 19,
                  "end": 19
                }
              },
              {
                "range": {
                  "end": 20,
                  "start": 20
                },
                "result": "Mortal wound",
                "showDescription": true,
                "description": "- You have received a fatal blow and will die, no Treatment can save you.\n- You may take one last Action on your next Turn before expiring. Make it count!\n- Your body is recoverable, so perhaps there is a chance at \nsome unnatural resurrection...\n- Bio-Mechanoid? You lie not dead, but offline. You have one chance at being rebooted but the Advanced Treatment will suffer a Snag. Failing this, maybe your core could be transferred to an alternative shell."
              }
            ],
            "name": "Injury Table",
            "baseRoll": "1d20"
          }
        }
      },
